@page
@model Libreria.Web.Pages.Productos.CreateModel

@{
    ViewData["Title"] = "Registrar producto";
}

<div class="page-header">
    <div>
        <h1>Registrar producto</h1>
        <p>Ingrese los detalles del nuevo producto para el inventario.</p>
    </div>
</div>

<!-- Contenedor tipo tarjeta para quitar el efecto flotante y limitar el ancho -->
<div class="form-card">
    <form method="post" id="productoForm">
        
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Input.Nombre">Nombre <span class="text-danger">*</span></label>
            <input asp-for="Input.Nombre" class="form-control" placeholder="Ej: Cuaderno universitario" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.DescripcionEspecifica">Descripción</label>
            <textarea asp-for="Input.DescripcionEspecifica" class="form-control" rows="3" placeholder="Detalles adicionales..."></textarea>
            <span asp-validation-for="Input.DescripcionEspecifica" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.CategoriaId">Categoría <span class="text-danger">*</span></label>
            <select asp-for="Input.CategoriaId" class="form-control">
                <option value="0">Seleccione una categoría</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.CategoriaId">
                        @categoria.Nombre
                    </option>
                }
            </select>
            <span asp-validation-for="Input.CategoriaId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.MarcaId">Marca <span class="text-danger">*</span></label>
            <select asp-for="Input.MarcaId" class="form-control">
                <option value="0">Seleccione una marca</option>
                @foreach (var marca in Model.Marcas)
                {
                    <option value="@marca.MarcaId">
                        @marca.Nombre
                    </option>
                }
            </select>
            <span asp-validation-for="Input.MarcaId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Stock">Stock</label>
            <input asp-for="Input.Stock" type="number" min="0" class="form-control" placeholder="0" />
            <span asp-validation-for="Input.Stock" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.PrecioVenta">Precio de venta (Bs.) <span class="text-danger">*</span></label>
            <input asp-for="Input.PrecioVenta" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
             <span asp-validation-for="Input.PrecioVenta" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.CostoAdquisicion">Costo de adquisición (Bs.) <span class="text-danger">*</span></label>
            <input asp-for="Input.CostoAdquisicion" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
            <span asp-validation-for="Input.CostoAdquisicion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.FechaVencimiento">Fecha de vencimiento (Opcional)</label>
            <input asp-for="Input.FechaVencimiento" type="date" class="form-control" />
             <span asp-validation-for="Input.FechaVencimiento" class="text-danger"></span>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn--primary">Guardar producto</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>

    </form>
</div>

<!-- Mantenemos intacto el script de validación de negocio -->
<script>
    document.getElementById("productoForm").addEventListener("submit", function (event) {
        const precioVenta = parseFloat(
            document.getElementById("Input_PrecioVenta").value
        );

        const costoAdquisicion = parseFloat(
            document.getElementById("Input_CostoAdquisicion").value
        );

        if (!isNaN(precioVenta) &&
            !isNaN(costoAdquisicion) &&
            precioVenta < costoAdquisicion) {

            const confirmar = confirm(
                "El precio de venta es menor al costo de adquisición. ¿Está seguro de continuar?"
            );

            if (!confirmar) {
                event.preventDefault();
            }
        }
    });
</script>