@page "{id:int}"
@model Libreria.Web.Pages.Productos.EditModel

@{
    ViewData["Title"] = "Editar producto";
}

<h1>Editar producto</h1>

<form method="post" id="productoForm">
    <input type="hidden" asp-for="ProductoId" />
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Input.Nombre">Nombre</label>
        <input asp-for="Input.Nombre" />
        <span asp-validation-for="Input.Nombre"></span>
    </div>

    <div>
        <label asp-for="Input.DescripcionEspecifica">Descripción</label>
        <textarea asp-for="Input.DescripcionEspecifica"></textarea>
        <span asp-validation-for="Input.DescripcionEspecifica"></span>
    </div>

    <div>
        <label asp-for="Input.CategoriaId">Categoría</label>
        <select asp-for="Input.CategoriaId">
            <option value="0">Seleccione una categoría</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria.CategoriaId">@categoria.Nombre</option>
            }
        </select>
        <span asp-validation-for="Input.CategoriaId"></span>
    </div>

    <div>
        <label asp-for="Input.MarcaId">Marca</label>
        <select asp-for="Input.MarcaId">
            <option value="0">Seleccione una marca</option>
            @foreach (var marca in Model.Marcas)
            {
                <option value="@marca.MarcaId">@marca.Nombre</option>
            }
        </select>
        <span asp-validation-for="Input.MarcaId"></span>
    </div>

    <div>
        <label asp-for="Input.Stock">Stock</label>
        <input asp-for="Input.Stock" type="number" min="0" />
        <span asp-validation-for="Input.Stock"></span>
    </div>

    <div>
        <label asp-for="Input.PrecioVenta">Precio de venta</label>
        <input asp-for="Input.PrecioVenta" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Input.PrecioVenta"></span>
    </div>

    <div>
        <label asp-for="Input.CostoAdquisicion">Costo de adquisición</label>
        <input asp-for="Input.CostoAdquisicion" type="number" step="0.01" min="0" />
        <span asp-validation-for="Input.CostoAdquisicion"></span>
    </div>

    <div>
        <label asp-for="Input.FechaVencimiento">Fecha de vencimiento</label>
        <input asp-for="Input.FechaVencimiento" type="date" />
        <span asp-validation-for="Input.FechaVencimiento"></span>
    </div>

    <button type="submit">Guardar cambios</button>
    <a asp-page="Details" asp-route-id="@Model.ProductoId">Cancelar</a>
</form>

<script>
    document.getElementById("productoForm").addEventListener("submit", function (event) {
        const precioVenta = parseFloat(
            document.getElementById("Input_PrecioVenta").value
        );

        const costoAdquisicion = parseFloat(
            document.getElementById("Input_CostoAdquisicion").value
        );

        if (!isNaN(precioVenta) &&
            !isNaN(costoAdquisicion) &&
            precioVenta < costoAdquisicion) {

            const confirmar = confirm(
                "El precio de venta es menor al costo de adquisición. ¿Está seguro de continuar?"
            );

            if (!confirmar) {
                event.preventDefault();
            }
        }
    });
</script>