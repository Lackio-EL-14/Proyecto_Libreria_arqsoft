@page
@model Libreria.Web.Pages.Historico.IndexModel
@{
    ViewData["Title"] = "Histórico de costos";
}

<h1>Histórico de costos</h1>

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="alert alert-danger" role="alert">
        @Model.MensajeError
    </div>
}
else
{
    <div class="mb-3">
        <h4>@Model.NombreProducto</h4>
    </div>

    @if (Model.Historial.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Este producto no tiene registros históricos de costo.
        </div>
    }
    else
    {
        <div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Costo anterior</th>
                        <th>Costo nuevo</th>
                        <th>Variación</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Historial)
                    {
                        <tr>
                            <td>
                                @item.FechaVigencia.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (item.CostoAnterior.HasValue)
                                {
                                    @item.CostoAnterior.Value.ToString("0.00")
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                            <td>
                                @item.CostoNuevo.ToString("0.00")
                            </td>

                            <td>
                                @if (item.VariacionAbsoluta.HasValue)
                                {
                                    var variacion = item.VariacionAbsoluta.Value;

                                    if (variacion > 0)
                                    {
                                        <span>+@variacion.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span>@variacion.ToString("0.00")</span>
                                    }
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Motivo))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @item.Motivo
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p>
        @if (Model.ProductoActivo)
        {
            <a asp-page="/Productos/Details" asp-route-id="@Model.ProductoId">Volver al producto</a>
        }
        else
        {
            <a asp-page="/Productos/Index">Volver a productos</a>
        }
    </p>
}
