@page "{id:int}"
@model Libreria.Web.Pages.Categorias.DeleteModel
@{
    ViewData["Title"] = "Dar de Baja Categoría";
}

<div style="margin-top: 20px; max-width: 600px;">
    <h2 style="color: red;">Confirmar Baja de Categoría</h2>
    <hr />

    <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
        <strong>¿Estás seguro de que deseas desactivar esta categoría?</strong><br />
        Esta acción la ocultará de los formularios de registro (Estado = Inactivo), pero no eliminará su historial en el sistema.
    </div>

    @if (Model.TieneProductos)
    {
        <div style="background-color: #fff3cd; color: #856404; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #ffeeba;">
            <strong>⚠️ Advertencia:</strong> Esta categoría tiene productos activos asociados. 
            Darla de baja no eliminará los productos, pero la categoría ya no estará disponible para nuevas asignaciones.
        </div>
    }

    <div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ccc; border-radius: 5px;">
        <p><strong>Nombre:</strong> @Model.Categoria?.Nombre</p>
        <p><strong>Descripción:</strong> @(string.IsNullOrEmpty(Model.Categoria?.Descripcion) ? "N/A" : Model.Categoria?.Descripcion)</p>
        <p><strong>Estado Actual:</strong> @(Model.Categoria?.Estado == true ? "Activo" : "Inactivo")</p>
    </div>

    <form method="post">
        <input type="hidden" asp-for="CategoriaId" />
        
        <button type="submit" style="padding: 10px 15px; background-color: #dc3545; color: white; border: none; cursor: pointer; font-weight: bold;">
            Confirmar Baja
        </button>
        <a asp-page="./Index" style="margin-left: 10px; text-decoration: none; padding: 10px 15px; background-color: #6c757d; color: white;">
            Cancelar
        </a>
    </form>
</div>
