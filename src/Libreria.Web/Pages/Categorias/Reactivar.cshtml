@page "{id:int}"
@model Libreria.Web.Pages.Categorias.ReactivarModel
@{
    ViewData["Title"] = "Reactivar Categoría";
}

<div class="page-header">
    <div>
        <h1 style="color: var(--color-accent);">Confirmar Reactivación</h1>
        <p>Verifique la información antes de proceder.</p>
    </div>
</div>

<div class="form-card">
    <div style="background-color: #E8F0EB; color: var(--color-accent-hover); padding: 1.25rem; border-radius: var(--radius-base); margin-bottom: 1.5rem; border: 1px solid #A3C2B1;">
        <strong>¿Estás seguro de que deseas reactivar esta categoría?</strong><br />
        Esta acción hará que la categoría vuelva a estar disponible en todos los formularios de registro de productos (Estado = Activo).
    </div>

    <!-- Tarjeta interna para mostrar los datos de la categoría -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-base); background-color: var(--color-bg);">
        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;"><strong>Código:</strong> @Model.Categoria?.Codigo</p>
        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;"><strong>Nombre:</strong> @Model.Categoria?.Nombre</p>
        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;"><strong>Descripción:</strong> @(string.IsNullOrEmpty(Model.Categoria?.Descripcion) ? "N/A" : Model.Categoria?.Descripcion)</p>
        <p style="margin-bottom: 0; font-size: 0.95rem;"><strong>Ubicación:</strong> @Model.Categoria?.Ubicacion</p>
    </div>

    <form method="post" style="display: flex; gap: 1rem;">
        <input type="hidden" asp-for="CategoriaId" />
        
        <button type="submit" class="btn btn--primary" style="background-color: var(--color-accent);">Confirmar Reactivación</button>
        <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
    </form>
</div>