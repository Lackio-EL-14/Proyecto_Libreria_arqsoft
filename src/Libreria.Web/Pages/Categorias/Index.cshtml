@page
@model Libreria.Web.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

@if (TempData["MensajeExito"] != null)
{
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
        @TempData["MensajeExito"]
    </div>
}

<div style="margin-bottom: 20px;">
    <a asp-page="./Create" style="margin-right: 20px; font-weight: bold; text-decoration: none;">+ Registrar Nueva Categoría</a>
    
    <form method="get" style="display: inline-block;">
        <input type="text" name="Busqueda" asp-for="Busqueda" placeholder="Buscar por nombre..." style="padding: 5px; width: 200px;" />
        <button type="submit" style="padding: 5px 10px;">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Busqueda))
        {
            <a asp-page="./Index" style="margin-left: 10px; color: red; text-decoration: none;">Limpiar filtro</a>
        }
    </form>
</div>

@if (!Model.Categorias.Any())
{
    <p>No hay categorías registradas todavía o ninguna coincide con la búsqueda.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Orden</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model.Categorias)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td>@(string.IsNullOrEmpty(categoria.Descripcion) ? "N/A" : categoria.Descripcion)</td>
                    <td>@categoria.Orden</td>
                    <td>
                        <!-- Indicador de estado claro -->
                        <span style="color: @(categoria.Estado ? "green" : "gray"); font-weight: bold;">
                            @(categoria.Estado ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        @if (categoria.Estado)
                        {
                            <a asp-page="./Edit" asp-route-id="@categoria.CategoriaId">Editar</a> @:|
                            <a asp-page="./Delete" asp-route-id="@categoria.CategoriaId" style="color: red;">Baja</a>
                        }
                        else
                        {
                            <a asp-page="./Reactivar" asp-route-id="@categoria.CategoriaId" style="color: green; font-weight: bold;">Reactivar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
