@page "{id:int}"
@model Libreria.Web.Pages.Categorias.EditModel
@{
    ViewData["Title"] = "Editar Categoría";
}

<div style="margin-top: 20px;">
    <h2>Editar Categoría</h2>
    <hr />

    <form method="post" style="max-width: 500px;">
        <input type="hidden" asp-for="CategoriaId" />
        <div asp-validation-summary="ModelOnly" style="color: red;"></div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Input.Codigo" style="font-weight: bold; display: block; margin-bottom: 5px;">Código *</label>
            <input asp-for="Input.Codigo" maxlength="20" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Input.Codigo" style="color: red; font-size: 14px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Input.Nombre" style="font-weight: bold; display: block; margin-bottom: 5px;">Nombre de la Categoría *</label>
            <input asp-for="Input.Nombre" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Input.Nombre" style="color: red; font-size: 14px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Input.Descripcion" style="font-weight: bold; display: block; margin-bottom: 5px;">Descripción</label>
            <textarea asp-for="Input.Descripcion" rows="3" style="width: 100%; padding: 8px;"></textarea>
            <span asp-validation-for="Input.Descripcion" style="color: red; font-size: 14px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Input.Ubicacion" style="font-weight: bold; display: block; margin-bottom: 5px;">Ubicación *</label>
            <input asp-for="Input.Ubicacion" maxlength="100" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Input.Ubicacion" style="color: red; font-size: 14px;"></span>
        </div>

        <div style="margin-top: 20px;">
            <button type="submit" style="padding: 10px 15px; background-color: #007bff; color: white; border: none; cursor: pointer;">Actualizar Categoría</button>
            <a asp-page="./Index" style="margin-left: 10px; text-decoration: none; padding: 10px 15px; background-color: #6c757d; color: white;">Cancelar</a>
        </div>
    </form>
</div>
