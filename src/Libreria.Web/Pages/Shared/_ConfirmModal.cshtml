@model Libreria.Web.Pages.Shared.Models.ConfirmModalModel

<dialog id="@Model.Id" class="confirmation-modal" aria-labelledby="@(Model.Id)-title" aria-modal="true">
    <form method="post" asp-page-handler="@Model.Handler" action="@Model.UrlAccion" class="confirmation-modal__content">
        @Html.AntiForgeryToken()
        <header class="confirmation-modal__header">
            <h2 id="@(Model.Id)-title">@Model.Titulo</h2>
            <button type="button" class="confirmation-modal__close" data-confirm-close aria-label="Cerrar modal">&times;</button>
        </header>

        <div class="confirmation-modal__body">
            <p>
                @Model.MensajePrincipal <strong data-confirm-name></strong>.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.MensajeAdvertencia))
            {
                <div class="confirmation-modal__warning" data-confirm-warning hidden>
                    <strong>⚠️ Advertencia:</strong> <span data-confirm-warning-text>@Model.MensajeAdvertencia</span>
                </div>
            }

            <input type="hidden" name="@Model.CampoIdentificador" data-confirm-id />
        </div>

        <footer class="confirmation-modal__actions">
            <button type="button" class="btn btn--secondary" data-confirm-close>@Model.TextoBotonCancelar</button>
            <button type="submit" class="btn btn--danger">@Model.TextoBotonConfirmar</button>
        </footer>
    </form>
</dialog>
