@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    Func<string, string> getActiveClass = (path) =>
    {
        if (path == "/Index" && currentPage == "/Index") return "is-active";
        if (path != "/Index" && currentPage.StartsWith(path, StringComparison.OrdinalIgnoreCase)) return "is-active";
        return "";
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Librería</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="app-body">
    <header class="app-header">
        <div class="app-header__left">
            <!-- Botón para alternar sidebar móvil / colapso desktop -->
            <button
                type="button"
                class="menu-toggle"
                id="menuToggle"
                aria-label="Alternar menú de navegación"
                aria-controls="sidebar"
                aria-expanded="false"
                title="Alternar menú">
                <span aria-hidden="true">☰</span>
            </button>

            <div class="app-header__brand">
                <a asp-page="/Index" aria-label="Ir al inicio" class="brand-link">
                    <img src="~/images/icono.svg" alt="Librería" class="brand-logo" />
                    <span class="brand-name">Librería</span>
                </a>
            </div>
        </div>
    </header>

    <div class="app-layout">
        <!-- Mini-Sidebar Colapsable -->
        <aside
            class="app-sidebar"
            id="sidebar"
            aria-label="Navegación principal">

            <div class="sidebar-header">
                <span class="sidebar-header__title">Navegación</span>
                <button
                    type="button"
                    class="sidebar-collapse-btn"
                    id="sidebarCollapseBtn"
                    aria-label="Colapsar o expandir menú lateral"
                    title="Alternar vista mini-sidebar">
                    <span class="collapse-icon">◀</span>
                </button>
            </div>

            <nav class="sidebar-nav">
                <!-- Sección Principal -->
                <div class="sidebar-section">
                    <span class="sidebar-section__title">General</span>
                    <a class="sidebar-link @getActiveClass("/Index")" asp-page="/Index" title="Inicio / Dashboard">
                        <span class="sidebar-link__icon" aria-hidden="true">📊</span>
                        <span class="sidebar-link__text">Inicio</span>
                    </a>
                </div>

                <!-- Sección Inventario y Catálogos -->
                <div class="sidebar-section">
                    <span class="sidebar-section__title">Inventario</span>
                    <a class="sidebar-link @getActiveClass("/Productos")" asp-page="/Productos/Index" title="Consultar productos">
                        <span class="sidebar-link__icon" aria-hidden="true">📦</span>
                        <span class="sidebar-link__text">Productos</span>
                    </a>
                    <a class="sidebar-link @getActiveClass("/Categorias")" asp-page="/Categorias/Index" title="Categorías">
                        <span class="sidebar-link__icon" aria-hidden="true">🏷️</span>
                        <span class="sidebar-link__text">Categorías</span>
                    </a>
                    <a class="sidebar-link @getActiveClass("/Marcas")" asp-page="/Marcas/Index" title="Marcas">
                        <span class="sidebar-link__icon" aria-hidden="true">🏢</span>
                        <span class="sidebar-link__text">Marcas</span>
                    </a>
                    <a class="sidebar-link @getActiveClass("/Historico")" asp-page="/Historico/Index" title="Histórico de costos">
                        <span class="sidebar-link__icon" aria-hidden="true">📈</span>
                        <span class="sidebar-link__text">Histórico de costos</span>
                    </a>
                </div>

                <!-- Sección Módulos Futuros / Visión Comercial -->
                <div class="sidebar-section sidebar-section--future">
                    <span class="sidebar-section__title">Próximamente</span>
                    <a href="#" class="sidebar-link sidebar-link--disabled" tabindex="-1" aria-disabled="true" title="Reportes (Próximamente)">
                        <span class="sidebar-link__icon" aria-hidden="true">📑</span>
                        <span class="sidebar-link__text">Reportes</span>
                        <span class="sidebar-link__lock" aria-label="Bloqueado">🔒</span>
                    </a>
                    <a href="#" class="sidebar-link sidebar-link--disabled" tabindex="-1" aria-disabled="true" title="Ventas (Próximamente)">
                        <span class="sidebar-link__icon" aria-hidden="true">🛒</span>
                        <span class="sidebar-link__text">Ventas</span>
                        <span class="sidebar-link__lock" aria-label="Bloqueado">🔒</span>
                    </a>
                    <a href="#" class="sidebar-link sidebar-link--disabled" tabindex="-1" aria-disabled="true" title="Compras (Próximamente)">
                        <span class="sidebar-link__icon" aria-hidden="true">📥</span>
                        <span class="sidebar-link__text">Compras</span>
                        <span class="sidebar-link__lock" aria-label="Bloqueado">🔒</span>
                    </a>
                    <a href="#" class="sidebar-link sidebar-link--disabled" tabindex="-1" aria-disabled="true" title="Carrito (Próximamente)">
                        <span class="sidebar-link__icon" aria-hidden="true">🛍️</span>
                        <span class="sidebar-link__text">Carrito</span>
                        <span class="sidebar-link__lock" aria-label="Bloqueado">🔒</span>
                    </a>
                </div>
            </nav>
        </aside>

        <button
            type="button"
            class="sidebar-overlay"
            id="sidebarOverlay"
            aria-label="Cerrar menú">
        </button>

        <div class="app-content-wrapper">
            <main class="app-main" id="main-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <p>Proyecto Académico — Clean Code &amp; SOLID | Razor Pages &amp; ADO.NET</p>
            </footer>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/confirm-modal.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
