@page
@model Libreria.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Panel Principal";
}

<!-- Hero Section Principal -->
<header class="home-hero">
    <img src="~/images/icono.svg" alt="Logotipo Librería" class="home-hero__logo" />
    <div>
        <h1>Sistema de Gestión de Librería</h1>
        <p>Panel de control operativo, catálogo de inventario, métricas clave y auditoría de costos.</p>
    </div>
</header>

<!-- Sección de Indicadores Clave (KPIs / Widgets) -->
<section class="kpi-grid" aria-label="Indicadores clave del sistema">
    <!-- Widget 1: Total Productos Activos -->
    <article class="kpi-card">
        <div class="kpi-card__icon kpi-card__icon--primary">📦</div>
        <div class="kpi-card__info">
            <span class="kpi-card__label">Total Productos Activos</span>
            <span class="kpi-card__value">@Model.TotalProductos</span>
            <span class="kpi-card__hint">@(Model.TotalPerecederos) perecederos registrados</span>
        </div>
        <a asp-page="/Productos/Index" class="kpi-card__link" title="Ver catálogo de productos">Ir al catálogo →</a>
    </article>

    <!-- Widget 2: Stock Crítico / Alerta -->
    <article class="kpi-card @(Model.ProductosStockCritico > 0 ? "kpi-card--warning" : "")">
        <div class="kpi-card__icon @(Model.ProductosStockCritico > 0 ? "kpi-card__icon--warning" : "kpi-card__icon--primary")">⚠️</div>
        <div class="kpi-card__info">
            <span class="kpi-card__label">Stock Crítico (≤ 5 un.)</span>
            <span class="kpi-card__value @(Model.ProductosStockCritico > 0 ? "text-warning" : "")">@Model.ProductosStockCritico</span>
            <span class="kpi-card__hint">@(Model.ProductosStockCritico > 0 ? "Requieren reposición urgente" : "Niveles de stock óptimos")</span>
        </div>
        <a asp-page="/Productos/Index" class="kpi-card__link" title="Consultar productos">Revisar stock →</a>
    </article>

    <!-- Widget 3: Categorías Activas -->
    <article class="kpi-card">
        <div class="kpi-card__icon kpi-card__icon--accent">🏷️</div>
        <div class="kpi-card__info">
            <span class="kpi-card__label">Categorías Activas</span>
            <span class="kpi-card__value">@Model.TotalCategorias</span>
            <span class="kpi-card__hint">Organización y ubicaciones</span>
        </div>
        <a asp-page="/Categorias/Index" class="kpi-card__link" title="Gestionar categorías">Ver categorías →</a>
    </article>

    <!-- Widget 4: Marcas Registradas -->
    <article class="kpi-card">
        <div class="kpi-card__icon kpi-card__icon--primary">🏢</div>
        <div class="kpi-card__info">
            <span class="kpi-card__label">Marcas Registradas</span>
            <span class="kpi-card__value">@Model.TotalMarcas</span>
            <span class="kpi-card__hint">Fabricantes y proveedores</span>
        </div>
        <a asp-page="/Marcas/Index" class="kpi-card__link" title="Gestionar marcas">Ver marcas →</a>
    </article>
</section>

<!-- Secciones Operativas: Accesos Rápidos y Módulos Futuros -->
<div class="dashboard-sections">
    <!-- Accesos Rápidos del Catálogo e Histórico -->
    <section class="dashboard-panel">
        <div class="dashboard-panel__header">
            <h2>⚡ Acciones Operativas Rápidas</h2>
            <p>Acceso directo a las tareas frecuentes del catálogo e inventario.</p>
        </div>
        <div class="quick-actions-grid">
            <a asp-page="/Productos/Create" class="quick-action-item">
                <span class="quick-action-item__icon">➕</span>
                <div>
                    <strong>Registrar Producto</strong>
                    <p>Alta de nuevo artículo en catálogo</p>
                </div>
            </a>
            <a asp-page="/Productos/Index" class="quick-action-item">
                <span class="quick-action-item__icon">🔍</span>
                <div>
                    <strong>Consultar Inventario</strong>
                    <p>Búsqueda y filtros por categoría/marca</p>
                </div>
            </a>
            <a asp-page="/Categorias/Create" class="quick-action-item">
                <span class="quick-action-item__icon">🏷️</span>
                <div>
                    <strong>Nueva Categoría</strong>
                    <p>Asignación de ubicación en almacén</p>
                </div>
            </a>
            <a asp-page="/Marcas/Create" class="quick-action-item">
                <span class="quick-action-item__icon">🏢</span>
                <div>
                    <strong>Nueva Marca</strong>
                    <p>Registro de proveedor o fabricante</p>
                </div>
            </a>
        </div>
    </section>

    <!-- Proyección y Visión Comercial (Módulos Futuros) -->
    <section class="dashboard-panel">
        <div class="dashboard-panel__header">
            <h2>🚀 Próximamente (En Desarrollo)</h2>
            <p>Módulos proyectados en la hoja de ruta de la solución.</p>
        </div>
        <div class="future-modules-grid">
            <div class="future-module-item">
                <div class="future-module-item__header">
                    <span>📊 Reportes y Analítica</span>
                    <span class="badge">🔒 Próx.</span>
                </div>
                <p>Informes de rotación de productos y balance de inventario.</p>
            </div>
            <div class="future-module-item">
                <div class="future-module-item__header">
                    <span>🛒 Ventas y Facturación</span>
                    <span class="badge">🔒 Próx.</span>
                </div>
                <p>Emisión de notas de venta, tickets y caja en mostrador.</p>
            </div>
            <div class="future-module-item">
                <div class="future-module-item__header">
                    <span>📥 Compras a Proveedores</span>
                    <span class="badge">🔒 Próx.</span>
                </div>
                <p>Recepción de órdenes y control de lotes de adquisición.</p>
            </div>
            <div class="future-module-item">
                <div class="future-module-item__header">
                    <span>🛍️ Carrito / Mostrador</span>
                    <span class="badge">🔒 Próx.</span>
                </div>
                <p>Simulador de punto de venta rápido y canasta de artículos.</p>
            </div>
        </div>
    </section>
</div>
