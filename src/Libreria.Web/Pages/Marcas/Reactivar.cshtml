@page "{id:guid}"
@model Libreria.Web.Pages.Marcas.ReactivarModel

@{
    ViewData["Title"] = "Reactivar marca";
}

<div class="page-header">
    <div>
        <h1 style="color: var(--color-accent);">Confirmar reactivación</h1>
        <p>Verifique la información antes de proceder.</p>
    </div>
</div>

<div class="form-card">
    <div style="background-color: #E8F0EB; color: var(--color-accent-hover); padding: 1.25rem; border-radius: var(--radius-base); margin-bottom: 1.5rem; border: 1px solid #A3C2B1;">
        <strong>¿Está seguro de que desea reactivar esta marca?</strong><br />
        Esta acción hará que la marca vuelva a estar disponible en el sistema.
    </div>

    <div style="margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-base); background-color: var(--color-bg);">
        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">
            <strong>Nombre:</strong> @Model.Marca?.Nombre
        </p>

        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">
            <strong>Descripción:</strong>
            @(string.IsNullOrEmpty(Model.Marca?.Descripcion)
                ? "—"
                : Model.Marca?.Descripcion)
        </p>

        <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">
            <strong>País de origen:</strong> @Model.Marca?.PaisOrigen
        </p>

        <p style="margin-bottom: 0; font-size: 0.95rem;">
            <strong>Sitio web:</strong>
            @(string.IsNullOrEmpty(Model.Marca?.SitioWeb)
                ? "—"
                : Model.Marca?.SitioWeb)
        </p>
    </div>

    <form method="post" style="display: flex; gap: 1rem;">
        <input type="hidden" asp-for="PublicId" />

        <button type="submit"
                class="btn btn--primary"
                style="background-color: var(--color-accent);">
            Confirmar reactivación
        </button>

        <a asp-page="./Index" class="btn btn--secondary">
            Cancelar
        </a>
    </form>
</div>