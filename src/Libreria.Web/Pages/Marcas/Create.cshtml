@page
@using Libreria.Web.Domain.Catalogs
@model Libreria.Web.Pages.Marcas.CreateModel

@{
    ViewData["Title"] = "Registrar marca";
}

<div class="page-header">
    <div>
        <h1>Registrar marca</h1>
        <p>Ingrese los datos de la nueva marca.</p>
    </div>
</div>

<div class="form-card">
    <form method="post">
        
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Input.Nombre">Nombre:</label>
            <input asp-for="Input.Nombre" class="form-control" maxlength="100" placeholder="Ej. Faber-Castell" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Descripcion">Descripción:</label>
            <textarea asp-for="Input.Descripcion" class="form-control" maxlength="255" rows="4" placeholder="Descripción de la marca"></textarea>
            <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.PaisOrigen">País de origen:</label>
            <select asp-for="Input.PaisOrigen" class="form-control">
            <option value="">Seleccione un país</option>

            @foreach (var pais in PaisesMarca.Todos)
            {
                <option value="@pais">@pais</option>
            }
            </select>



            <span asp-validation-for="Input.PaisOrigen" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.SitioWeb">Sitio web:</label>
            <input asp-for="Input.SitioWeb" class="form-control" maxlength="200" placeholder="https://ejemplo.com" />
            <span asp-validation-for="Input.SitioWeb" class="text-danger"></span>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn--primary">Guardar</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>