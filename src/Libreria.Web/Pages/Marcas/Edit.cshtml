@page
@model Libreria.Web.Pages.Marcas.EditModel

@{
    ViewData["Title"] = "Editar marca";
}

<div class="page-header">
    <div>
        <h1>Editar marca</h1>
        <p>Modifique los datos de la marca seleccionada.</p>
    </div>
</div>

<div class="form-card">
    <form method="post">
        <input type="hidden" asp-for="MarcaId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Input.Nombre">Nombre: <span class="text-danger">*</span></label>
            <input asp-for="Input.Nombre" class="form-control" maxlength="100" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Descripcion">Descripción:</label>
            <textarea asp-for="Input.Descripcion" class="form-control" maxlength="255" rows="4"></textarea>
            <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.PaisOrigen">País de origen:</label>
            <input asp-for="Input.PaisOrigen" class="form-control" maxlength="100" />
            <span asp-validation-for="Input.PaisOrigen" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.SitioWeb">Sitio web:</label>
            <input asp-for="Input.SitioWeb" class="form-control" maxlength="200" placeholder="https://ejemplo.com" />
            <span asp-validation-for="Input.SitioWeb" class="text-danger"></span>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn--primary">Guardar cambios</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>