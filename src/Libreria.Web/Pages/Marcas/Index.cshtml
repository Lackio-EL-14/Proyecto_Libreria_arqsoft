@page
@model Libreria.Web.Pages.Marcas.IndexModel
@using Libreria.Web.Pages.Shared.Models

@{
    ViewData["Title"] = "Marcas";
}

<div class="page-header">
    <div>
        <h1>Marcas</h1>
        <p>Consulta y gestión de marcas registradas en el sistema.</p>
    </div>
    <a asp-page="./Create" class="btn btn--primary">+ Registrar nueva marca</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div style="background-color: #E8F0EB; color: var(--color-accent); padding: 1rem; border-radius: var(--radius-base); margin-bottom: 1.5rem; border: 1px solid #A3C2B1;">
        @TempData["MensajeExito"]
    </div>
}

<!-- Filtro horizontal compacto -->
<form method="get" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 1.5rem; background-color: var(--color-surface); padding: 1.25rem; border-radius: var(--radius-base); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
    
    <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 250px;">
        <label for="nombre">Buscar por nombre:</label>
        <input type="text" id="nombre" name="nombre" class="form-control" value="@Model.NombreBusqueda" maxlength="100" placeholder="Ej. Norma" />
    </div>

    <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn--secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Marcas.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(Model.NombreBusqueda))
    {
        <div style="text-align: center; color: var(--color-secondary); padding: 2rem; background-color: var(--color-surface); border-radius: var(--radius-base); border: 1px solid var(--color-border);">
            <p>No hay marcas registradas todavía.</p>
        </div>
    }
    else
    {
        <div style="text-align: center; color: var(--color-secondary); padding: 2rem; background-color: var(--color-surface); border-radius: var(--radius-base); border: 1px solid var(--color-border);">
            <p>No se encontraron marcas que coincidan con "<strong>@Model.NombreBusqueda</strong>".</p>
        </div>
    }
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>País de origen</th>
                    <th>Sitio web</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var marca in Model.Marcas)
                {
                    <tr>
                        <td style="font-weight: 600;">@marca.Nombre</td>
                        <td>@(marca.Descripcion ?? "—")</td>
                        <td>@(marca.PaisOrigen ?? "—")</td>
                        <td>
                            @if (marca.SitioWeb is not null)
                            {
                                <a href="@marca.SitioWeb" target="_blank" rel="noopener noreferrer" style="color: var(--color-primary); font-weight: 500;">Visitar ↗</a>
                            }
                            else
                            {
                                <span style="color: var(--color-secondary);">—</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="./Edit" asp-route-id="@marca.PublicId" class="btn-table">Editar</a>
                                <button
                                    type="button"
                                    class="btn-table btn-table--danger"
                                    data-confirm-trigger
                                    data-modal-target="marca-baja-modal"
                                    data-entity-id="@marca.PublicId"
                                    data-entity-name="@marca.Nombre"
                                    data-has-warning="@Model.MarcasConProductosActivos.Contains(marca.PublicId).ToString().ToLowerInvariant()">
                                    Dar de baja
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "marca-baja-modal",
        Titulo = "Confirmar baja de marca",
        MensajePrincipal = "¿Desea dar de baja la marca",
        Handler = "DarDeBaja",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Confirmar baja",
        TextoBotonCancelar = "Cancelar",
        MensajeAdvertencia = "La marca tiene productos activos asociados. Los productos conservarán su información, pero la marca dejará de estar disponible para nuevas asignaciones."
    })
