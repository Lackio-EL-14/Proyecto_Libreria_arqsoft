@page
@model Libreria.Web.Pages.Marcas.IndexModel

@{
    ViewData["Title"] = "Marcas";
}

<h1>Marcas</h1>

<p>Consulta de marcas registradas en el sistema.</p>

<form method="get">
    <label for="nombre">Buscar por nombre:</label>

    <input
        type="text"
        id="nombre"
        name="nombre"
        value="@Model.NombreBusqueda"
        maxlength="100"
        placeholder="Ej. Norma" />

    <button type="submit">
        Buscar
    </button>

    @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
    {
        <a asp-page="./Index">
            Limpiar
        </a>
    }
</form>

@if (Model.Marcas.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(Model.NombreBusqueda))
    {
        <p>No hay marcas registradas todavía.</p>
    }
    else
    {
        <p>
            No se encontraron marcas que coincidan con
            "<strong>@Model.NombreBusqueda</strong>".
        </p>
    }
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>País de origen</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var marca in Model.Marcas)
            {
                <tr>
                    <td>@marca.Nombre</td>

                    <td>
                        @(marca.Descripcion ?? "—")
                    </td>

                    <td>
                        @(marca.PaisOrigen ?? "—")
                    </td>

                    <td>
                        @if (marca.Estado)
                        {
                            <strong>Activo</strong>
                        }
                        else
                        {
                            <span>Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}