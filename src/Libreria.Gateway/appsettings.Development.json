    "Clusters": {
      "clientes": {
        "Destinations": {
          "principal": { "Address": "http://localhost:5101" }
        }
      },
      "productos": {
        "Destinations": {
          "principal": { "Address": "http://localhost:5101" }
        }
      }
    }
  }
}
