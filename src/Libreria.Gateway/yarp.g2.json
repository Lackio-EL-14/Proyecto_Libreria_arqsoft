{
  "ReverseProxy": {
    "Routes": {
      "g2-auth": {
        "ClusterId": "usuarios",
        "Match": { "Path": "/api/auth/{**resto}" }
      },
      "g2-usuarios": {
        "ClusterId": "usuarios",
        "Match": { "Path": "/api/usuarios/{**resto}" }
      }
    },
    "Clusters": {
      "usuarios": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5102" }
        }
      }
    }
  }
}
