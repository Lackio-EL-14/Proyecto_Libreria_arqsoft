{
  "ReverseProxy": {
    "Routes": {
      "g1-clientes": {
        "ClusterId": "clientes",
        "Match": { "Path": "/api/clientes/{**resto}" }
      },
      "g1-ventas": {
        "ClusterId": "ventas",
        "Match": { "Path": "/api/ventas/{**resto}" }
      },
      "g1-productos": {
        "ClusterId": "productos",
        "Match": { "Path": "/api/productos/{**resto}" }
      },
      "g1-categorias": {
        "ClusterId": "productos",
        "Match": { "Path": "/api/categorias/{**resto}" }
      },
      "g1-marcas": {
        "ClusterId": "productos",
        "Match": { "Path": "/api/marcas/{**resto}" }
      },
      "g1-historico": {
        "ClusterId": "productos",
        "Match": { "Path": "/api/historico/{**resto}" }
      }
    },
    "Clusters": {
      "clientes": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5103" }
        }
      },
      "ventas": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5101" }
        }
      },
      "productos": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "principal": { "Address": "http://localhost:5104" }
        }
      }
    }
  }
}
