@page
@model Libreria.Client.Pages.Historico.IndexModel
@{
    ViewData["Title"] = "Histórico de costos";
}

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="estado-pagina" role="alert">
        <span class="estado-pagina__icono estado-pagina__icono--peligro"><partial name="_Icono" model="@("alerta")" /></span>
        <h1>Información no disponible</h1>
        <p>@Model.MensajeError</p>
        <a asp-page="/Productos/Index" class="btn btn--secondary">Volver a productos</a>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Histórico de costos</h1>
            <p>Producto: <strong>@Model.NombreProducto</strong>. Cada fila es un cambio del costo de adquisición.</p>
        </div>
        @if (Model.ProductoActivo)
        {
            <a asp-page="/Productos/Details" asp-route-id="@Model.PublicId" class="btn btn--secondary">Volver al producto</a>
        }
        else
        {
            <a asp-page="/Productos/Index" class="btn btn--secondary">Volver a productos</a>
        }
    </div>

    @if (Model.Historial.Count == 0)
    {
        <div class="estado-vacio">
            <partial name="_Icono" model="@("reloj")" />
            <p>Este producto todavía no tiene cambios de costo. Cuando se edite su costo de adquisición, el cambio aparecerá aquí.</p>
        </div>
    }
    else
    {
        <p class="tabla-resumen" role="status">@Model.Historial.Count @(Model.Historial.Count == 1 ? "registro" : "registros"), del más reciente al más antiguo.</p>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th class="num">Costo anterior</th>
                        <th class="num">Costo nuevo</th>
                        <th class="num">Variación</th>
                        <th>Vencimiento</th>
                        <th>Motivo</th>
                        <th>Registrado por</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Historial)
                    {
                        <tr>
                            <td>@FechaLocal.Mostrar(item.FechaVigencia)</td>
                            <td class="num">
                                @if (item.CostoAnterior.HasValue)
                                {
                                    <span>Bs. @item.CostoAnterior.Value.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="texto-secundario">—</span>
                                }
                            </td>
                            <td class="num celda-principal">Bs. @item.CostoNuevo.ToString("0.00")</td>
                            <td class="num">
                                @if (item.VariacionAbsoluta.HasValue)
                                {
                                    var variacion = item.VariacionAbsoluta.Value;
                                    if (variacion > 0)
                                    {
                                        <span class="variacion variacion--sube">+@variacion.ToString("0.00")</span>
                                    }
                                    else if (variacion < 0)
                                    {
                                        <span class="variacion variacion--baja">@variacion.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="texto-secundario">0.00</span>
                                    }
                                }
                                else
                                {
                                    <span class="texto-secundario">—</span>
                                }
                            </td>
                            <td>
                                @if (item.FechaVencimiento.HasValue)
                                {
                                    @item.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="texto-secundario">—</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Motivo))
                                {
                                    <span class="texto-secundario">—</span>
                                }
                                else
                                {
                                    @item.Motivo
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.RegistradoPor))
                                {
                                    <span class="texto-secundario">—</span>
                                }
                                else
                                {
                                    @item.RegistradoPor
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
