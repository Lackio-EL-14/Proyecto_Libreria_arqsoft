@page
@model Libreria.Client.Pages.Proveedores.IndexModel
@using Libreria.Client.DTOs.Proveedores
@using Libreria.Client.Pages.Shared.Models
@{
    ViewData["Title"] = "Proveedores";

    var rutaActual = new Dictionary<string, string?>
    {
        ["busqueda"] = Model.Busqueda,
        ["estado"] = Model.Estado.ToString(),
        ["orden"] = Model.Orden.ToString(),
        ["descendente"] = Model.Descendente.ToString().ToLowerInvariant()
    };

    var columnas = new[]
    {
        (OrdenProveedores.Nit, "NIT"),
        (OrdenProveedores.RazonSocial, "Razón social"),
        (OrdenProveedores.Correo, "Correo"),
        (OrdenProveedores.FechaCreacion, "Fecha de registro")
    };
}

<div class="page-header">
    <div>
        <h1>Proveedores</h1>
        <p>Consulta y gestión de los proveedores y su contacto principal.</p>
    </div>
    <a asp-page="./Create" class="btn btn--primary"><partial name="_Icono" model="@("mas")" /> Registrar proveedor</a>
</div>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="mensaje mensaje--exito" role="status">@mensajeExito</div>
}
@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="mensaje mensaje--error" role="alert">@mensajeError</div>
}

<form method="get" class="filtro-barra" novalidate>
    <input type="hidden" name="orden" value="@Model.Orden" />
    <input type="hidden" name="descendente" value="@Model.Descendente.ToString().ToLowerInvariant()" />

    <div class="form-group filtro-barra__campo">
        <label for="busqueda">Buscar por NIT, razón social, correo o contacto</label>
        <input id="busqueda" name="busqueda" value="@Model.Busqueda" class="form-control" maxlength="200" placeholder="Ej. 1020304050 o Andina" />
    </div>
    <div class="form-group filtro-barra__estado">
        <label for="estado">Estado</label>
        <select id="estado" name="estado" class="form-control">
            <option value="Activos" selected="@(Model.Estado == EstadoFiltroProveedores.Activos ? "selected" : null)">Activos</option>
            <option value="Inactivos" selected="@(Model.Estado == EstadoFiltroProveedores.Inactivos ? "selected" : null)">Inactivos</option>
            <option value="Todos" selected="@(Model.Estado == EstadoFiltroProveedores.Todos ? "selected" : null)">Todos</option>
        </select>
    </div>
    <div class="filtro-barra__acciones">
        <button type="submit" class="btn btn--secondary">Buscar</button>
        <a asp-page="./Index" asp-all-route-data="rutaActual" class="btn btn--secondary">Actualizar</a>
        @if (Model.HayFiltros)
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Proveedores.Count == 0)
{
    <div class="estado-vacio">
        <partial name="_Icono" model="@("proveedores")" />
        @if (Model.HayFiltros)
        {
            <p>No se encontraron proveedores con los filtros aplicados. Revise la búsqueda o pulse «Limpiar».</p>
        }
        else
        {
            <p>No hay proveedores registrados todavía.</p>
            <a asp-page="./Create" class="btn btn--primary"><partial name="_Icono" model="@("mas")" /> Registrar proveedor</a>
        }
    </div>
}
else
{
    <p class="tabla-resumen" role="status">Se muestran @Model.Proveedores.Count @(Model.Proveedores.Count == 1 ? "proveedor" : "proveedores").</p>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    @foreach (var columna in columnas)
                    {
                        <th aria-sort="@Model.AriaSort(columna.Item1)">
                            <a asp-page="./Index" asp-all-route-data="Model.RutaOrden(columna.Item1)" class="tabla-orden" title="Ordenar por @columna.Item2.ToLowerInvariant()">
                                @columna.Item2 <span aria-hidden="true">@Model.IndicadorOrden(columna.Item1)</span>
                            </a>
                        </th>
                    }
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th class="col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Model.Proveedores)
                {
                    <tr>
                        <td>@proveedor.Nit</td>
                        <td class="celda-principal">@proveedor.RazonSocial</td>
                        <td>@(proveedor.Correo ?? "—")</td>
                        <td>@FechaLocal.Mostrar(proveedor.FechaCreacion)</td>
                        <td>
                            @proveedor.NombreContacto
                            <small>@(proveedor.TelefonoContacto ?? proveedor.CorreoContacto)</small>
                        </td>
                        <td>
                            <span class="badge @(proveedor.Estado ? "badge--accent" : "")">
                                @(proveedor.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="table-actions">
                                @if (proveedor.Estado)
                                {
                                    <a asp-page="./Edit" asp-route-id="@proveedor.PublicId" class="btn-table">Editar</a>
                                    <button
                                        type="button"
                                        class="btn-table btn-table--danger"
                                        data-confirm-trigger
                                        data-modal-target="proveedor-baja-modal"
                                        data-entity-id="@proveedor.PublicId"
                                        data-entity-name="@proveedor.RazonSocial">
                                        Dar de baja
                                    </button>
                                }
                                else
                                {
                                    <button
                                        type="button"
                                        class="btn-table"
                                        data-confirm-trigger
                                        data-modal-target="proveedor-reactivar-modal"
                                        data-entity-id="@proveedor.PublicId"
                                        data-entity-name="@proveedor.RazonSocial">
                                        Reactivar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_ConfirmModal", new ConfirmModalModel
{
    Id = "proveedor-baja-modal",
    Titulo = "Confirmar baja de proveedor",
    MensajePrincipal = "¿Desea dar de baja al proveedor",
    Handler = "DarDeBaja",
    TextoBotonConfirmar = "Confirmar baja"
})

@await Html.PartialAsync("_ConfirmModal", new ConfirmModalModel
{
    Id = "proveedor-reactivar-modal",
    Titulo = "Confirmar reactivación",
    MensajePrincipal = "¿Desea reactivar al proveedor",
    Handler = "Reactivar",
    TextoBotonConfirmar = "Reactivar",
    ClaseBotonConfirmar = "btn--primary"
})
