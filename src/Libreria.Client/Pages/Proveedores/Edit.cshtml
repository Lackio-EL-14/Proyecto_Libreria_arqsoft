@page "{id:guid}"
@model Libreria.Client.Pages.Proveedores.EditModel
@{
    ViewData["Title"] = "Editar proveedor";
}

<div class="page-header">
    <div>
        <h1>Editar proveedor</h1>
        <p>Actualice los datos del proveedor y su contacto principal.</p>
    </div>
</div>

<div class="form-card form-card--ancha">
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <partial name="_ProveedorFormularioCampos" for="Input" />
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Guardar cambios</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

@if (Model.Auditoria is not null)
{
    <partial name="_AuditoriaInfo" model="Model.Auditoria" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
