@model Libreria.Client.DTOs.Proveedores.ProveedorInput

@* Campos comunes del alta y la edición. Se usa con <partial for="Input">: los nombres "Input.*"
   coinciden con las claves de error que devuelve el MS Proveedores. Etiquetas y mensajes salen de
   ProveedorInput ([Display], [Required], [RequeridoAlgunoDe]…); jQuery unobtrusive los muestra antes
   de enviar y el MS vuelve a validar con su Result. *@
<p class="form-obligatorio">Los campos con <span class="text-danger">*</span> son obligatorios.</p>

<fieldset class="form-seccion">
    <legend>Datos del proveedor</legend>
    <div class="form-grid">
        <div class="form-group">
            <label asp-for="Nit"></label>
            <input asp-for="Nit" class="form-control" maxlength="30" />
            <span asp-validation-for="Nit" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="RazonSocial"></label>
            <input asp-for="RazonSocial" class="form-control" maxlength="200" />
            <span asp-validation-for="RazonSocial" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Telefono"></label>
            <input asp-for="Telefono" class="form-control" maxlength="30" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Correo"></label>
            <input asp-for="Correo" class="form-control" type="email" maxlength="254" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>
    </div>
</fieldset>

<fieldset class="form-seccion">
    <legend>Contacto principal</legend>
    <p class="form-ayuda" id="ayuda-medio-contacto">Indique al menos un teléfono o un correo del contacto.</p>
    <div class="form-grid">
        <div class="form-group">
            <label asp-for="NombreContacto"></label>
            <input asp-for="NombreContacto" class="form-control" maxlength="150" />
            <span asp-validation-for="NombreContacto" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CargoContacto"></label>
            <input asp-for="CargoContacto" class="form-control" maxlength="100" />
            <span asp-validation-for="CargoContacto" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="TelefonoContacto"></label>
            <input asp-for="TelefonoContacto" class="form-control" maxlength="30" aria-describedby="ayuda-medio-contacto" />
            <span asp-validation-for="TelefonoContacto" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CorreoContacto"></label>
            <input asp-for="CorreoContacto" class="form-control" type="email" maxlength="254" aria-describedby="ayuda-medio-contacto" />
            <span asp-validation-for="CorreoContacto" class="text-danger"></span>
        </div>
    </div>
</fieldset>
