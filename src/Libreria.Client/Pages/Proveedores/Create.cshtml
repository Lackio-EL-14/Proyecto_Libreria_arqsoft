@page
@model Libreria.Client.Pages.Proveedores.CreateModel
@{
    ViewData["Title"] = "Registrar proveedor";
}

<div class="page-header">
    <div>
        <h1>Registrar proveedor</h1>
        <p>Ingrese los datos comerciales y del contacto principal.</p>
    </div>
</div>

<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <partial name="_ProveedorFormularioCampos" model="Model.Input" />
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Guardar</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>
