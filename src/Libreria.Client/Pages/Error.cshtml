@page
@model Libreria.Client.Pages.ErrorModel
@{
    ViewData["Title"] = "Error del sistema";
}

<div class="estado-pagina" role="alert">
    <span class="estado-pagina__icono estado-pagina__icono--peligro"><partial name="_Icono" model="@("alerta")" /></span>
    <h1>No se pudo completar la acción</h1>
    <p>Ocurrió un error inesperado al procesar la solicitud. Intente de nuevo o vuelva al inicio.</p>

    @if (Model.ShowRequestId)
    {
        <p class="estado-pagina__codigo">Código para soporte: <code>@Model.RequestId</code></p>
    }

    <a asp-page="/Index" class="btn btn--primary">Volver al inicio</a>
</div>
