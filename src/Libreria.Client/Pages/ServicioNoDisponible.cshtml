@page
@model Libreria.Client.Pages.ServicioNoDisponibleModel
@{
    ViewData["Title"] = "Servicio no disponible";
}

<div class="estado-pagina" role="alert">
    <span class="estado-pagina__icono"><partial name="_Icono" model="@("desconectado")" /></span>
    <h1>Servicio no disponible</h1>
    <p>El servicio de @Model.Servicio no respondió a tiempo. No se perdió información: intente de nuevo en unos momentos.</p>
    <a asp-page="/Index" class="btn btn--primary">Volver al inicio</a>
</div>
