@page
@model Libreria.Client.Pages.Usuarios.IndexModel
@using Libreria.Client.Pages.Shared.Models
@{
    ViewData["Title"] = "Usuarios";
}

<div class="page-header">
    <div>
        <h1>Usuarios</h1>
        <p>Consulta de usuarios registrados en el sistema.</p>
    </div>
    <a asp-page="./Create" class="btn btn--primary">+ Registrar usuario</a>
</div>

@if (TempData["MensajeExito"] is string exito)
{
    <div class="mensaje mensaje--exito" role="status">@exito</div>
}
@if (TempData["MensajeError"] is string error)
{
    <div class="mensaje mensaje--error" role="alert">@error</div>
}

<form method="get" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 1.5rem;">
    <input type="hidden" name="Orden" value="@Model.Orden" />
    <input type="hidden" name="Descendente" value="@Model.Descendente.ToString().ToLowerInvariant()" />
    <div class="form-group" style="margin-bottom: 0;">
        <label asp-for="Estado">Estado</label>
        <select asp-for="Estado" class="form-control">
            <option value="">Todos</option>
            @foreach (var estado in Model.Estados)
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn--secondary">Filtrar</button>
    <a asp-page="./Index" asp-all-route-data="Model.RutaActual" class="btn btn--secondary" title="Volver a consultar el listado con los mismos filtros">Actualizar</a>
    <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
</form>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (ViewData.ModelState.IsValid)
{
    @if (Model.Usuarios.Count == 0)
    {
        <p>No se encontraron usuarios para el estado seleccionado.</p>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        @foreach (var (columna, titulo) in new[] { ("nombre", "Nombre completo"), ("usuario", "Nombre de usuario"), ("correo", "Correo electrónico"), ("rol", "Rol"), ("estado", "Estado") })
                        {
                            <th>
                                <a asp-page="./Index" asp-all-route-data="Model.RutaOrden(columna)" class="tabla-orden" title="Ordenar por @titulo.ToLowerInvariant()">
                                    @titulo <span aria-hidden="true">@Model.IndicadorOrden(columna)</span>
                                </a>
                            </th>
                        }
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>@usuario.FullName</td>
                            <td>@usuario.Username</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Role</td>
                            <td>@usuario.Status</td>
                            <td>
                                @if (usuario.Status != EstadosUsuario.Inactivo)
                                {
                                    <button type="button"
                                            class="btn-table btn-table--danger"
                                            data-confirm-trigger
                                            data-modal-target="usuario-baja-modal"
                                            data-entity-id="@Model.ProtegerId(usuario.PublicId)"
                                            data-entity-name="@usuario.FullName">
                                        Dar de baja
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@await Html.PartialAsync("_ConfirmModal", new ConfirmModalModel
{
    Id = "usuario-baja-modal",
    Titulo = "Dar de baja usuario",
    MensajePrincipal = "¿Desea dar de baja al usuario",
    Handler = "DarDeBaja",
    CampoIdentificador = "publicId",
    TextoBotonConfirmar = "Confirmar baja"
})
