@page
@model Libreria.Client.Pages.Usuarios.CreateModel
@{
    ViewData["Title"] = "Crear usuario";
}

<div class="page-header">
    <div>
        <h1>Crear usuario</h1>
        <p>Ingrese los datos del nuevo usuario.</p>
    </div>
</div>

<div class="form-card">
    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="mensaje mensaje--exito" role="status">
            @Model.MensajeExito
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="validation-summary-errors"
         role="alert"></div>

    <form method="post">
        <div class="form-group">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Apellido">Apellido paterno</label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ApellidoMaterno">Apellido materno (opcional)</label>
            <input asp-for="ApellidoMaterno" class="form-control" />
            <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Correo">Correo</label>
            <input asp-for="Correo"
                   type="email"
                   class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rol">Rol</label>
            <select asp-for="Rol"
                    asp-items="Model.Roles"
                    class="form-control">
                <option value="">Seleccione un rol</option>
            </select>
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.NombreUsuario))
        {
            <div class="form-group">
                <label for="nombre-usuario-generado">Nombre de usuario generado</label>
                <input id="nombre-usuario-generado"
                       type="text"
                       class="form-control"
                       value="@Model.NombreUsuario"
                       readonly />
            </div>
        }

        <div class="form-actions">
            <button type="submit"
                    asp-page-handler="Crear"
                    class="btn btn--primary">
                Crear usuario
            </button>
            <a asp-page="./Index" class="btn btn--secondary">Volver</a>
        </div>
    </form>
</div>
