@page
@model Libreria.Client.Pages.Usuarios.CreateModel
@{
    ViewData["Title"] = "Registrar usuario";
}

<div class="page-header">
    <div>
        <h1>Registrar usuario</h1>
        <p>El nombre de usuario y una contraseña temporal se generan solos y se envían al correo indicado.</p>
    </div>
</div>

<div class="form-card">
    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="mensaje mensaje--exito" role="status">
            @Model.MensajeExito
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="validation-summary-errors"
         role="alert"></div>

    <form method="post" novalidate>
        <p class="form-obligatorio">Los campos con <span class="text-danger">*</span> son obligatorios.</p>
        <div class="form-grid">
        <div class="form-group form-grid__completo">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Apellido"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ApellidoMaterno"></label>
            <input asp-for="ApellidoMaterno" class="form-control" />
            <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Correo"></label>
            <input asp-for="Correo"
                   type="email"
                   class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Rol"></label>
            <select asp-for="Rol"
                    asp-items="Model.Roles"
                    class="form-control">
                <option value="">Seleccione un rol</option>
            </select>
            <span asp-validation-for="Rol" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.NombreUsuario))
        {
            <div class="form-group form-grid__completo">
                <label for="nombre-usuario-generado">Nombre de usuario generado</label>
                <input id="nombre-usuario-generado"
                       type="text"
                       class="form-control"
                       value="@Model.NombreUsuario"
                       readonly />
            </div>
        }

        </div>

        <div class="form-actions">
            <button type="submit"
                    asp-page-handler="Crear"
                    class="btn btn--primary">
                Registrar usuario
            </button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
