@page
@model Libreria.Client.Pages.Reportes.SalesReportModel
@{
    ViewData["Title"] = "Reporte de ventas";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-BO");
}

<div class="page-header">
    <div>
        <h1>Reporte de ventas</h1>
        <p>Ventas activas agrupadas por producto y categoría.</p>
    </div>
    <a asp-page="./Index" class="btn btn--secondary">Reporte de productos</a>
</div>

<form method="get" class="form-card" style="display:flex; flex-wrap:wrap; gap:1rem; align-items:flex-end; margin-bottom:1.5rem;">
    <div class="form-group" style="flex:1; min-width:150px; margin:0;">
        <label asp-for="Filter.DateFrom">Fecha desde</label>
        <input asp-for="Filter.DateFrom" type="date" class="form-control" />
    </div>
    <div class="form-group" style="flex:1; min-width:150px; margin:0;">
        <label asp-for="Filter.DateTo">Fecha hasta</label>
        <input asp-for="Filter.DateTo" type="date" class="form-control" />
    </div>
    <div class="form-group" style="flex:2; min-width:200px; margin:0;">
        <label asp-for="Filter.CategoryPublicId">Categoría</label>
        <select asp-for="Filter.CategoryPublicId" class="form-control">
            <option value="">Todas las categorías</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.PublicId">@category.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn--primary">Consultar</button>
    <button type="submit" name="handler" value="Pdf" class="btn btn--secondary">Descargar PDF</button>
    <button type="submit" name="handler" value="Excel" class="btn btn--secondary">Descargar Excel</button>
    <a asp-page="./Ventas" class="btn btn--secondary">Limpiar</a>
</form>
<p>Las fechas son opcionales. Una fecha vacía no limita ese extremo del rango. Se incluye el día completo según la fecha registrada de la venta.</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary-errors" role="alert">
        Revise las fechas y la categoría. La fecha desde no puede ser posterior a la fecha hasta.
    </div>
}
else if (Model.ErrorMessage is not null)
{
    <div class="validation-summary-errors" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Report is not null)
{
    @if (Model.Report.Rows.Count == 0)
    {
        <div class="form-card">No se encontraron ventas con los filtros seleccionados.</div>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead><tr><th>Producto</th><th>Categoría</th><th>Cantidad vendida</th><th>Total vendido</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Report.Rows)
                {
                    <tr><td>@row.Name</td><td>@row.Category</td><td>@row.Quantity</td><td>Bs @row.Amount.ToString("N2", culture)</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="form-card">
        <p>Total de unidades vendidas: @Model.Report.TotalQuantity</p>
        <p>Total vendido: Bs @Model.Report.TotalAmount.ToString("N2", culture)</p>
    </div>
}
