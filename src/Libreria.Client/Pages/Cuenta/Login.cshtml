@page
@model Libreria.Client.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutCuenta";
}

<section class="auth-card" aria-labelledby="auth-title">
    <div class="auth-card__brand">
        <img src="~/images/icono.svg" alt="Librería" class="auth-card__logo" />
        <h1 id="auth-title">Iniciar sesión</h1>
        <p>Ingrese sus credenciales para acceder al sistema.</p>
    </div>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Input.NombreUsuario">Usuario</label>
            <input asp-for="Input.NombreUsuario" class="form-control" maxlength="50"
                   autocomplete="username" autofocus />
            <span asp-validation-for="Input.NombreUsuario" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Contrasena">Contraseña</label>
            <input asp-for="Input.Contrasena" type="password" class="form-control" maxlength="128"
                   autocomplete="current-password" />
            <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn--primary auth-card__submit">Ingresar</button>
    </form>
</section>
