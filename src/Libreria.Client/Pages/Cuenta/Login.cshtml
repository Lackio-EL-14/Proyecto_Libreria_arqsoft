@page
@model Libreria.Client.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutCuenta";
}

<section class="auth-card" aria-labelledby="auth-title">
    <div class="auth-card__brand">
        <img src="~/images/icono.svg" alt="Librería" class="auth-card__logo" />
        <h1 id="auth-title">Iniciar sesión</h1>
        <p>El acceso al sistema se valida con el proveedor de identidad de la librería.</p>
    </div>

    @if (Model.Mensaje is not null)
    {
        <div class="@(Model.EsAviso ? "validation-summary-errors" : "auth-card__info")" role="status">
            @Model.Mensaje
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="btn btn--primary auth-card__submit">Iniciar sesión</button>
    </form>
</section>
