@page
@model Libreria.Client.Pages.Cuenta.CambiarContrasenaModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-header">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>Al guardar la nueva contraseña se cerrará su sesión y deberá ingresar de nuevo con ella.</p>
    </div>
</div>

<div class="form-card">
    <form method="post" id="cambiar-contrasena" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <p class="form-obligatorio">Los campos con <span class="text-danger">*</span> son obligatorios.</p>
        <div class="form-group">
            <label asp-for="Input.ContrasenaActual"></label>
            <input asp-for="Input.ContrasenaActual" type="password" class="form-control"
                   autocomplete="current-password" maxlength="128" />
            <span asp-validation-for="Input.ContrasenaActual" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.NuevaContrasena"></label>
            <input asp-for="Input.NuevaContrasena" type="password" class="form-control"
                   autocomplete="new-password" maxlength="128" aria-describedby="reglas-contrasena" />
            <span asp-validation-for="Input.NuevaContrasena" class="text-danger"></span>
            <ul id="reglas-contrasena" class="reglas-contrasena" aria-live="polite">
                <li data-regla="longitud">Mínimo 8 caracteres.</li>
                <li data-regla="mayuscula">Al menos una mayúscula.</li>
                <li data-regla="minuscula">Al menos una minúscula.</li>
                <li data-regla="numero">Al menos un número.</li>
                <li data-regla="especial">Al menos un carácter especial.</li>
            </ul>
        </div>
        <div class="form-group">
            <label asp-for="Input.Confirmacion"></label>
            <input asp-for="Input.Confirmacion" type="password" class="form-control"
                   autocomplete="new-password" maxlength="128" />
            <span asp-validation-for="Input.Confirmacion" class="text-danger"></span>
            <p id="estado-confirmacion" class="estado-confirmacion" role="status"></p>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Cambiar contraseña</button>
            <a asp-page="/Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cambiar-contrasena.js" asp-append-version="true"></script>
}
