@page
@model Libreria.Client.Pages.Marcas.IndexModel

@{
    ViewData["Title"] = "Marcas";
}

<div class="page-header">
    <div>
        <h1>Marcas</h1>
        <p>Consulta de las marcas del catálogo. Se asignan al registrar o editar un producto.</p>
    </div>
</div>


<form method="get" class="filtro-barra">
    <div class="form-group filtro-barra__campo">
        <label for="nombre">Buscar por nombre</label>
        <input type="text" id="nombre" name="nombre" class="form-control" value="@Model.NombreBusqueda" maxlength="100" placeholder="Ej. Norma" />
    </div>

    <div class="filtro-barra__acciones">
        <button type="submit" class="btn btn--secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Marcas.Count == 0)
{
    <div class="estado-vacio">
        <partial name="_Icono" model="@("marcas")" />
        @if (string.IsNullOrWhiteSpace(Model.NombreBusqueda))
        {
            <p>No hay marcas registradas todavía.</p>
        }
        else
        {
            <p>No se encontraron marcas que coincidan con «<strong>@Model.NombreBusqueda</strong>». Revise lo escrito o pulse «Limpiar».</p>
        }
    </div>
}
else
{
    <p class="tabla-resumen" role="status">Se muestran @Model.Marcas.Count @(Model.Marcas.Count == 1 ? "marca" : "marcas").</p>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>País de origen</th>
                    <th>Sitio web</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var marca in Model.Marcas)
                {
                    <tr>
                        <td class="celda-principal">@marca.Nombre</td>
                        <td>@(marca.Descripcion ?? "—")</td>
                        <td>@(marca.PaisOrigen ?? "—")</td>
                        <td>
                            @if (marca.SitioWeb is not null)
                            {
                                <a href="@marca.SitioWeb" target="_blank" rel="noopener noreferrer" class="enlace-externo">Abrir sitio web <span class="sr-only">(se abre en otra pestaña)</span></a>
                            }
                            else
                            {
                                <span class="texto-secundario">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

