@page
@model Libreria.Client.Pages.Categorias.EditModel
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="page-header">
    <div>
        <h1>Editar Categoría</h1>
        <p>Modifique los datos de la categoría seleccionada.</p>
    </div>
</div>

<div class="form-card">
    <form method="post">
        <input type="hidden" asp-for="PublicId" />
        
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Input.Codigo">
                Código de la Categoría
                <span class="badge" style="font-size: 0.75rem; font-weight: normal; margin-left: 0.5rem; background-color: var(--color-secondary-light); color: var(--color-secondary);">
                    Autogenerado - Solo lectura
                </span>
            </label>
            <input asp-for="Input.Codigo"
                   class="form-control"
                   maxlength="20"
                   readonly
                   tabindex="-1"
                   aria-readonly="true"
                   style="background-color: var(--color-secondary-light); cursor: not-allowed; color: var(--color-secondary); font-family: monospace; font-weight: 600; border-color: var(--color-border);" />
            <small style="display: block; margin-top: 0.25rem; font-size: 0.8rem; color: var(--color-secondary);">
                El código es generado automáticamente por el sistema al registrar la categoría y no puede ser modificado.
            </small>
            <span asp-validation-for="Input.Codigo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Nombre">Nombre de la Categoría <span class="text-danger">*</span></label>
            <input asp-for="Input.Nombre" class="form-control" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Descripcion">Descripción</label>
            <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Ubicacion">Ubicación <span class="text-danger">*</span></label>
            <select asp-for="Input.Ubicacion" class="form-control">
                <option value="">Seleccione una ubicación</option>
                @foreach (var ubicacion in Model.Ubicaciones)
                {
                    <option value="@ubicacion">@ubicacion</option>
                }
            </select>
            <span asp-validation-for="Input.Ubicacion" class="text-danger"></span>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn--primary">Actualizar Categoría</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

@if (Model.Auditoria is not null)
{
    <partial name="_AuditoriaInfo" model="Model.Auditoria" />
}
