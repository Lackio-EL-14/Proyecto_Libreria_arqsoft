@page
@model Libreria.Client.Pages.Categorias.IndexModel

@{
    ViewData["Title"] = "Categorías";
}

<div class="page-header">
    <div>
        <h1>Categorías</h1>
        <p>Consulta de las categorías del catálogo. Se asignan al registrar o editar un producto.</p>
    </div>
</div>


<form method="get" class="filtro-barra" novalidate>
    <div class="form-group filtro-barra__campo">
        <label for="Busqueda">Buscar por código, nombre o ubicación</label>
        <input type="text" name="Busqueda" asp-for="Busqueda" class="form-control" placeholder="Ej: LIBROS" />
    </div>

    <div class="filtro-barra__acciones">
        <button type="submit" class="btn btn--secondary">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Busqueda))
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (!Model.Categorias.Any())
{
    <div class="estado-vacio">
        <partial name="_Icono" model="@("categorias")" />
        <p>No hay categorías registradas todavía o ninguna coincide con la búsqueda.</p>
    </div>
}
else
{
    <p class="tabla-resumen" role="status">Se muestran @Model.Categorias.Count @(Model.Categorias.Count == 1 ? "categoría" : "categorías").</p>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Ubicación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in Model.Categorias)
                {
                    <tr>
                        <td class="celda-principal">@categoria.Codigo</td>
                        <td>@categoria.Nombre</td>
                        <td>@(string.IsNullOrEmpty(categoria.Descripcion) ? "—" : categoria.Descripcion)</td>
                        <td>@categoria.Ubicacion</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

