@using Libreria.Client.Seguridad
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    // US-39: el menú consulta las MISMAS políticas que protegen las páginas
    // en el servidor (Program.cs), así menú y permisos no se desincronizan.
    var esAdministrador = (await AuthorizationService.AuthorizeAsync(User, PoliticasAcceso.SoloAdministrador)).Succeeded;
    var puedeVender = (await AuthorizationService.AuthorizeAsync(User, PoliticasAcceso.Ventas)).Succeeded;

    // Las páginas de Ventas las agregan otras historias (US-47 / US-52);
    // el enlace aparece solo cuando la página exista.
    var urlRegistrarVenta = Url.Page("/Ventas/Registrar");
    var urlListadoVentas = Url.Page("/Ventas/Index");

    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    Func<string, string> getActiveClass = (path) =>
    {
        if (path == "/Index" && currentPage == "/Index") return "is-active";
        if (path != "/Index" && currentPage.StartsWith(path, StringComparison.OrdinalIgnoreCase)) return "is-active";
        return "";
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Librería</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="app-body">
    <header class="app-header">
        <div class="app-header__left">
            <!-- Botón para alternar sidebar móvil / colapso desktop -->
            <button
                type="button"
                class="menu-toggle"
                id="menuToggle"
                aria-label="Alternar menú de navegación"
                aria-controls="sidebar"
                aria-expanded="false"
                title="Alternar menú">
                <span aria-hidden="true">☰</span>
            </button>

            <div class="app-header__brand">
                <a asp-page="/Index" aria-label="Ir al inicio" class="brand-link">
                    <img src="~/images/icono.svg" alt="Librería" class="brand-logo" />
                    <span class="brand-name">Librería</span>
                </a>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="app-header__user">
                <div class="user-chip" title="Sesión activa">
                    <span class="user-chip__name">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
                    <span class="user-chip__role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
                <form method="post" asp-page="/Cuenta/Logout" class="logout-form">
                    <button type="submit" class="btn-logout" title="Cerrar sesión">Cerrar sesión</button>
                </form>
            </div>
        }
    </header>

    <div class="app-layout">
        <!-- Mini-Sidebar Colapsable -->
        <aside
            class="app-sidebar"
            id="sidebar"
            aria-label="Navegación principal">

            <div class="sidebar-header">
                <span class="sidebar-header__title">Navegación</span>
                <button
                    type="button"
                    class="sidebar-collapse-btn"
                    id="sidebarCollapseBtn"
                    aria-label="Colapsar o expandir menú lateral"
                    title="Alternar vista mini-sidebar">
                    <span class="collapse-icon">◀</span>
                </button>
            </div>

            <nav class="sidebar-nav">
                <!-- Sección Principal -->
                <div class="sidebar-section">
                    <span class="sidebar-section__title">General</span>
                    <a class="sidebar-link @getActiveClass("/Index")" asp-page="/Index" title="Inicio / Dashboard">
                        <span class="sidebar-link__icon" aria-hidden="true">📊</span>
                        <span class="sidebar-link__text">Inicio</span>
                    </a>
                </div>

                @if (puedeVender && (urlRegistrarVenta is not null || urlListadoVentas is not null))
                {
                    @* Sección Ventas (Administrador y Vendedor) *@
                    <div class="sidebar-section">
                        <span class="sidebar-section__title">Ventas</span>
                        @if (urlRegistrarVenta is not null)
                        {
                            <a class="sidebar-link @getActiveClass("/Ventas/Registrar")" href="@urlRegistrarVenta" title="Registrar venta">
                                <span class="sidebar-link__icon" aria-hidden="true">🧾</span>
                                <span class="sidebar-link__text">Registrar venta</span>
                            </a>
                        }
                        @if (urlListadoVentas is not null)
                        {
                            <a class="sidebar-link @getActiveClass("/Ventas/Index")" href="@urlListadoVentas" title="Listado de ventas">
                                <span class="sidebar-link__icon" aria-hidden="true">💵</span>
                                <span class="sidebar-link__text">Ventas</span>
                            </a>
                        }
                    </div>
                }

                @if (esAdministrador)
                {
                    @* Sección Inventario y Catálogos (solo Administrador) *@
                    <div class="sidebar-section">
                        <span class="sidebar-section__title">Inventario</span>
                        <a class="sidebar-link @getActiveClass("/Productos")" asp-page="/Productos/Index" title="Consultar productos">
                            <span class="sidebar-link__icon" aria-hidden="true">📦</span>
                            <span class="sidebar-link__text">Productos</span>
                        </a>
                        <a class="sidebar-link @getActiveClass("/Categorias")" asp-page="/Categorias/Index" title="Categorías">
                            <span class="sidebar-link__icon" aria-hidden="true">🏷️</span>
                            <span class="sidebar-link__text">Categorías</span>
                        </a>
                        <a class="sidebar-link @getActiveClass("/Marcas")" asp-page="/Marcas/Index" title="Marcas">
                            <span class="sidebar-link__icon" aria-hidden="true">🏢</span>
                            <span class="sidebar-link__text">Marcas</span>
                        </a>
                        <a class="sidebar-link @getActiveClass("/Historico")" asp-page="/Historico/Index" title="Histórico de costos">
                            <span class="sidebar-link__icon" aria-hidden="true">📈</span>
                            <span class="sidebar-link__text">Histórico de costos</span>
                        </a>
                    </div>
                }
            </nav>
        </aside>

        <button
            type="button"
            class="sidebar-overlay"
            id="sidebarOverlay"
            aria-label="Cerrar menú">
        </button>

        <div class="app-content-wrapper">
            <main class="app-main" id="main-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <p>Proyecto Académico — Clean Code &amp; SOLID | Razor Pages &amp; ADO.NET</p>
            </footer>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/confirm-modal.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
