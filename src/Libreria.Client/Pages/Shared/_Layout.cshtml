@using Libreria.Client.Seguridad
@using Libreria.Client.Pages.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var esAdministrador = (await AuthorizationService.AuthorizeAsync(User, PoliticasAcceso.SoloAdministrador)).Succeeded;
    var puedeGestionarClientes = (await AuthorizationService.AuthorizeAsync(User, PoliticasAcceso.GestionClientes)).Succeeded;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var menuModel = new MenuModuleViewModel(currentPage, esAdministrador, puedeGestionarClientes);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Librería</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="app-body">
    <header class="app-header">
        <div class="app-header__left">
            <!-- En escritorio colapsa el menú lateral; en el celular lo abre como panel -->
            <button
                type="button"
                class="menu-toggle"
                id="menuToggle"
                aria-label="Mostrar u ocultar el menú"
                aria-controls="sidebar"
                aria-expanded="false"
                title="Mostrar u ocultar el menú">
                <partial name="_Icono" model="@("menu")" />
            </button>

            <div class="app-header__brand">
                <a asp-page="/Index" aria-label="Ir al inicio" class="brand-link">
                    <img src="~/images/icono.svg" alt="Librería" class="brand-logo" />
                    <span class="brand-name">Librería</span>
                </a>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            var nombreVisible = User.NombreVisible();
            <div class="app-header__user">
                <div class="user-chip" title="Sesión activa">
                    <span class="user-chip__name">@nombreVisible</span>
                    <span class="user-chip__role">@User.RolesVisibles()</span>
                </div>
                <span class="user-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(nombreVisible) ? "?" : nombreVisible.Trim()[..1].ToUpperInvariant())</span>
                <a asp-page="/Cuenta/CambiarContrasena" class="btn-header" title="Cambiar contraseña">
                    <partial name="_Icono" model="@("llave")" />
                    <span class="btn-header__texto">Cambiar contraseña</span>
                </a>
                <form method="post" asp-page="/Cuenta/Logout" class="logout-form" novalidate>
                    <button type="submit" class="btn-header" title="Cerrar sesión">
                        <partial name="_Icono" model="@("salir")" />
                        <span class="btn-header__texto">Cerrar sesión</span>
                    </button>
                </form>
            </div>
        }
    </header>

    <div class="app-layout">
        <!-- Menú lateral: se colapsa con el botón del encabezado -->
        <aside
            class="app-sidebar"
            id="sidebar"
            aria-label="Navegación principal">

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <a class="sidebar-link @menuModel.ActiveClass("/Index")" asp-page="/Index" title="Inicio">
                        <span class="sidebar-link__icon"><partial name="_Icono" model="@("inicio")" /></span>
                        <span class="sidebar-link__text">Inicio</span>
                    </a>
                </div>

                <partial name="_MenuClientes" model="menuModel" />
                <partial name="_MenuProveedores" model="menuModel" />
                <partial name="_MenuInventario" model="menuModel" />
                <partial name="_MenuUsuarios" model="menuModel" />
            </nav>
        </aside>

        <button
            type="button"
            class="sidebar-overlay"
            id="sidebarOverlay"
            aria-label="Cerrar menú">
        </button>

        <div class="app-content-wrapper">
            <main class="app-main" id="main-content">
            @RenderBody()
            </main>

            <footer class="app-footer">
                <p>Sistema de Gestión de Librería</p>
            </footer>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/confirm-modal.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
