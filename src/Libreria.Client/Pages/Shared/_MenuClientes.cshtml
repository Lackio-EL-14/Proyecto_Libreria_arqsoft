@model Libreria.Client.Pages.Shared.Models.MenuModuleViewModel
@{
    // Administrador y Vendedor pueden gestionar clientes.
    var urlClientes = Url.Page("/Clientes/Index");
}

@if (Model.PuedeGestionarClientes && urlClientes is not null)
{
    <div class="sidebar-section">
        <span class="sidebar-section__title">Comercial</span>
        <a class="sidebar-link @Model.ActiveClass("/Clientes")" href="@urlClientes" title="Clientes">
            <span class="sidebar-link__icon"><partial name="_Icono" model="@("clientes")" /></span>
            <span class="sidebar-link__text">Clientes</span>
        </a>
    </div>
}
