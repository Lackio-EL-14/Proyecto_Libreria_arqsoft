@model Libreria.Client.Pages.Ventas.ClienteInput

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CiNit" class="form-label">CI / NIT <span class="text-danger">*</span></label>
        <input asp-for="CiNit" class="form-control" required />
        <span asp-validation-for="CiNit" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="RazonSocial" class="form-label">Razón Social <span class="text-danger">*</span></label>
        <input asp-for="RazonSocial" class="form-control" required />
        <span asp-validation-for="RazonSocial" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Correo" class="form-label">Correo Electrónico</label>
        <input asp-for="Correo" type="email" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TipoContacto" class="form-label">Tipo de Contacto</label>
        <select asp-for="TipoContacto" class="form-select">
            <option value="Cliente">Cliente Estándar</option>
            <option value="Empresa">Empresa Corporativa</option>
        </select>
        <span asp-validation-for="TipoContacto" class="text-danger"></span>
    </div>
</div>
