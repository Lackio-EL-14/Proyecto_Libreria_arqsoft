@model Libreria.Client.Pages.Shared.Models.MenuModuleViewModel
@{
    var urlRegistrarVenta = Url.Page("/Ventas/Registrar");
    var urlListadoVentas = Url.Page("/Ventas/Index");
    var urlProductos = Url.Page("/Productos/Index");
    var urlCategorias = Url.Page("/Categorias/Index");
    var urlMarcas = Url.Page("/Marcas/Index");
}

@if (Model.PuedeVender && (urlRegistrarVenta is not null || urlListadoVentas is not null))
{
    <div class="sidebar-section">
        <button
            type="button"
            class="sidebar-section__toggle"
            data-sidebar-section-toggle
            aria-controls="sidebar-section-ventas"
            aria-expanded="true">
            <span class="sidebar-section__title">Ventas</span>
            <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
        </button>
        <div class="sidebar-section__items" id="sidebar-section-ventas">
            @if (urlRegistrarVenta is not null)
            {
                <a class="sidebar-link @Model.ActiveClass("/Ventas/Registrar")" href="@urlRegistrarVenta" title="Registrar venta">
                    <span class="sidebar-link__icon" aria-hidden="true">🧾</span>
                    <span class="sidebar-link__text">Registrar venta</span>
                </a>
            }
            @if (urlListadoVentas is not null)
            {
                <a class="sidebar-link @Model.ActiveClass("/Ventas/Index")" href="@urlListadoVentas" title="Listado de ventas">
                    <span class="sidebar-link__icon" aria-hidden="true">💵</span>
                    <span class="sidebar-link__text">Ventas</span>
                </a>
            }
        </div>
    </div>
}

@if (Model.EsAdministrador && (urlProductos is not null || urlCategorias is not null || urlMarcas is not null))
{
    <div class="sidebar-section">
        <button
            type="button"
            class="sidebar-section__toggle"
            data-sidebar-section-toggle
            aria-controls="sidebar-section-inventario"
            aria-expanded="true">
            <span class="sidebar-section__title">Inventario</span>
            <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
        </button>
        <div class="sidebar-section__items" id="sidebar-section-inventario">
            @if (urlProductos is not null)
            {
                <a class="sidebar-link @Model.ActiveClass("/Productos")" href="@urlProductos" title="Consultar productos">
                    <span class="sidebar-link__icon" aria-hidden="true">📦</span>
                    <span class="sidebar-link__text">Productos</span>
                </a>
            }
            @if (urlCategorias is not null)
            {
                <a class="sidebar-link @Model.ActiveClass("/Categorias")" href="@urlCategorias" title="Categorías">
                    <span class="sidebar-link__icon" aria-hidden="true">🏷️</span>
                    <span class="sidebar-link__text">Categorías</span>
                </a>
            }
            @if (urlMarcas is not null)
            {
                <a class="sidebar-link @Model.ActiveClass("/Marcas")" href="@urlMarcas" title="Marcas">
                    <span class="sidebar-link__icon" aria-hidden="true">🏢</span>
                    <span class="sidebar-link__text">Marcas</span>
                </a>
            }
        </div>
    </div>
}
