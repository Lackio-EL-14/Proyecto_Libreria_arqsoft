@page
@model Libreria.Client.Pages.Diagnostico.CacheModel
@{
    ViewData["Title"] = "Diagnóstico de caché";
}

<div class="page-header">
    <div>
        <h1>Diagnóstico de caché Redis</h1>
        <p>Última consulta compartida de productos activos. La vista se actualiza automáticamente cada dos segundos.</p>
    </div>
    <a asp-page="/Productos/Index" class="btn btn--primary">Generar consulta</a>
</div>

@if (Model.UltimoResultado is null)
{
    <section class="dashboard-panel">
        <div class="dashboard-panel__header">
            <h2>Sin actividad registrada</h2>
            <p>Abra el catálogo de productos para generar el primer MISS o HIT.</p>
        </div>
    </section>
}
else
{
    <section class="kpi-grid" aria-label="Último diagnóstico de caché">
        <article class="kpi-card">
            <span class="kpi-card__label">Resultado</span>
            <span class="kpi-card__value">@Model.UltimoResultado.Resultado</span>
            <span class="kpi-card__hint">Origen: @Model.UltimoResultado.Origen</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-card__label">Réplica que consultó</span>
            <span class="kpi-card__value" style="font-size: 1.1rem;">@Model.UltimoResultado.Replica</span>
            <span class="kpi-card__hint">Balanceada por Nginx</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-card__label">TTL restante</span>
            <span class="kpi-card__value">@(Model.UltimoResultado.TtlSegundos?.ToString() ?? "—")</span>
            <span class="kpi-card__hint">segundos</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-card__label">Duración</span>
            <span class="kpi-card__value">@Model.UltimoResultado.Milisegundos.ToString("0.00")</span>
            <span class="kpi-card__hint">milisegundos</span>
        </article>
    </section>

    <section class="dashboard-panel">
        <div class="dashboard-panel__header">
            <h2>Detalle técnico</h2>
            <p>Información utilizada para demostrar MISS/HIT entre réplicas.</p>
        </div>
        <div class="table-container">
            <table>
                <tbody>
                    <tr><th>Clave lógica</th><td><code>@Model.UltimoResultado.Clave</code></td></tr>
                    <tr><th>Clave física en Redis</th><td><code>@Model.ClaveProductoFisica</code></td></tr>
                    <tr><th>Resultado</th><td>@Model.UltimoResultado.Resultado</td></tr>
                    <tr><th>Origen de los datos</th><td>@Model.UltimoResultado.Origen</td></tr>
                    <tr><th>Réplica</th><td>@Model.UltimoResultado.Replica</td></tr>
                    <tr><th>Fecha UTC</th><td>@Model.UltimoResultado.FechaUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}

<section class="dashboard-panel">
    <div class="dashboard-panel__header">
        <h2>Sesiones distribuidas</h2>
        <p>La cookie conserva una referencia protegida; el ticket autenticado se comparte en Redis entre todas las réplicas.</p>
    </div>
    <div class="table-container">
        <table>
            <tbody>
                <tr><th>Patrón de claves</th><td><code>@Model.PatronSesiones</code></td></tr>
                <tr><th>Inspección segura</th><td>Use <code>SCAN</code>, <code>TYPE</code> y <code>TTL</code>. No exponga el campo binario del ticket.</td></tr>
            </tbody>
        </table>
    </div>
</section>

<script>
    window.setTimeout(() => window.location.reload(), 2000);
</script>

