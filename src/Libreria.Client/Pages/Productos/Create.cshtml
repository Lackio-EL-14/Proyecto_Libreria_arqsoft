@page
@model Libreria.Client.Pages.Productos.CreateModel

@{
    ViewData["Title"] = "Registrar producto";
}

<div class="page-header">
    <div>
        <h1>Registrar producto</h1>
        <p>Añade un nuevo artículo al catálogo de la librería.</p>
    </div>
</div>

<div class="form-card">
    <form method="post" id="productoForm">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Input.Nombre"></label>
            <input asp-for="Input.Nombre" class="form-control" />
            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.DescripcionEspecifica"></label>
            <textarea asp-for="Input.DescripcionEspecifica" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.DescripcionEspecifica" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.CategoriaId"></label>
            <select asp-for="Input.CategoriaId" class="form-control">
                <option value="">Seleccione una categoría</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.CategoriaId">@c.Nombre</option>
                }
            </select>
            <span asp-validation-for="Input.CategoriaId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.MarcaId"></label>
            <select asp-for="Input.MarcaId" class="form-control">
                <option value="">Seleccione una marca</option>
                @foreach (var m in Model.Marcas)
                {
                    <option value="@m.MarcaId">@m.Nombre</option>
                }
            </select>
            <span asp-validation-for="Input.MarcaId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Stock"></label>
            <input asp-for="Input.Stock" class="form-control" type="number" min="0" />
            <span asp-validation-for="Input.Stock" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.PrecioVenta"></label>
            <input asp-for="Input.PrecioVenta" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Input.PrecioVenta" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.CostoAdquisicion"></label>
            <input asp-for="Input.CostoAdquisicion" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Input.CostoAdquisicion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input asp-for="Input.EsPerecedero"
                    type="checkbox"
                    id="esPerecedero" />
                <label asp-for="Input.EsPerecedero"
                    style="margin-bottom: 0; cursor: pointer;">
                    ¿Es producto perecedero?
                </label>
            </div>
            <span asp-validation-for="Input.EsPerecedero"
                class="text-danger"></span>
        </div>

        <div class="form-group"
            id="fechaVencimientoGroup"
            style="display: none;">
            <label asp-for="Input.FechaVencimiento"></label>
            <input asp-for="Input.FechaVencimiento"
                id="fechaVencimiento"
                type="date"
                min="@DateTime.Today.ToString("yyyy-MM-dd")"
                class="form-control" />

            <span asp-validation-for="Input.FechaVencimiento"
                class="text-danger"></span>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn--primary">Guardar producto</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>

    </form>
</div>

<!-- Modal Compartido para confirmación de precio menor al costo -->
<dialog id="modal-confirmar-precio" class="confirmation-modal" aria-labelledby="modal-confirmar-precio-title" aria-modal="true">
    <div class="confirmation-modal__content">
        <header class="confirmation-modal__header">
            <h2 id="modal-confirmar-precio-title">Confirmar precio de venta</h2>
            <button type="button" class="confirmation-modal__close" data-confirm-close aria-label="Cerrar modal">&times;</button>
        </header>

        <div class="confirmation-modal__body">
            <p>
                El precio de venta ingresado es menor al costo de adquisición.
            </p>

            <div class="confirmation-modal__warning" style="margin-top: 1rem; background-color: var(--color-warning-bg); border: 1px solid var(--color-warning-border); padding: 0.75rem; border-radius: var(--radius-base); font-size: 0.85rem;">
                <strong>⚠️ Advertencia:</strong> Registrar un producto con precio inferior al costo generará pérdidas al venderse. ¿Está seguro de continuar?
            </div>
        </div>

        <footer class="confirmation-modal__actions">
            <button type="button" class="btn btn--secondary" data-confirm-close>Cancelar</button>
            <button type="button" class="btn btn--danger" id="btnConfirmarPrecioModal">Guardar de todos modos</button>
        </footer>
    </div>
</dialog>

<script>
    let precioConfirmado = false;
    const form = document.getElementById("productoForm");
    const modalPrecio = document.getElementById("modal-confirmar-precio");
    const btnConfirmarPrecio = document.getElementById("btnConfirmarPrecioModal");

    form.addEventListener("submit", function (event) {
        if (precioConfirmado) {
            return;
        }

        const precioVenta = parseFloat(
            document.getElementById("Input_PrecioVenta").value
        );

        const costoAdquisicion = parseFloat(
            document.getElementById("Input_CostoAdquisicion").value
        );

        if (!isNaN(precioVenta) &&
            !isNaN(costoAdquisicion) &&
            precioVenta < costoAdquisicion) {

            event.preventDefault();
            if (typeof modalPrecio.showModal === "function") {
                modalPrecio.showModal();
            } else {
                modalPrecio.setAttribute("open", "");
                modalPrecio.style.display = "block";
            }
        }
    });

    btnConfirmarPrecio.addEventListener("click", function () {
        precioConfirmado = true;
        if (typeof modalPrecio.close === "function") {
            modalPrecio.close();
        } else {
            modalPrecio.removeAttribute("open");
            modalPrecio.style.display = "none";
        }
        form.requestSubmit();
    });

    const esPerecedero = document.getElementById("esPerecedero");
    const fechaGroup = document.getElementById("fechaVencimientoGroup");
    const fechaInput = document.getElementById("fechaVencimiento");

    function actualizarFechaVencimiento() {
        if (esPerecedero.checked) {
            fechaGroup.style.display = "block";
            fechaInput.disabled = false;
            fechaInput.required = true;
        } else {
            fechaInput.required = false;
            fechaInput.value = "";
            fechaInput.disabled = true;
            fechaGroup.style.display = "none";
        }
    }

    esPerecedero.addEventListener("change", actualizarFechaVencimiento);
    actualizarFechaVencimiento();
</script>
