@page "{id:guid}"
@model Libreria.Client.Pages.Productos.EditModel

@{
    ViewData["Title"] = "Editar producto";
}

<div class="page-header">
    <div>
        <h1>Editar producto</h1>
        <p>Modifique los datos del artículo seleccionado.</p>
    </div>
</div>

<div class="form-card form-card--ancha">
    <form method="post" id="productoForm" novalidate>
        <partial name="_ProductoFormularioCampos" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Guardar cambios</button>
            <a asp-page="Details" asp-route-id="@Model.PublicId" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

<dialog id="modal-confirmar-precio" class="confirmation-modal" aria-labelledby="modal-confirmar-precio-title" aria-modal="true">
    <div class="confirmation-modal__content">
        <header class="confirmation-modal__header">
            <h2 id="modal-confirmar-precio-title">Confirmar precio de venta</h2>
            <button type="button" class="confirmation-modal__close" data-confirm-close aria-label="Cerrar modal">&times;</button>
        </header>

        <div class="confirmation-modal__body">
            <p>
                El precio de venta ingresado es menor al costo de adquisición.
            </p>

            <div class="confirmation-modal__warning">
                <strong>Advertencia:</strong> Guardar el producto con un precio inferior al costo generará pérdidas al venderse. ¿Está seguro de continuar?
            </div>
        </div>

        <footer class="confirmation-modal__actions">
            <button type="button" class="btn btn--secondary" data-confirm-close>Cancelar</button>
            <button type="button" class="btn btn--danger" id="btnConfirmarPrecioModal">Guardar de todos modos</button>
        </footer>
    </div>
</dialog>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto-formulario.js" asp-append-version="true"></script>
}
