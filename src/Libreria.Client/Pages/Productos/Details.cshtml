@page "{id:guid}"
@model Libreria.Client.Pages.Productos.DetailsModel
@using Libreria.Client.Pages.Shared.Models

@{
    ViewData["Title"] = "Detalle del producto";
}

<div class="page-header">
    <div>
        <h1>Detalle del producto</h1>
        <p>Información completa del artículo en inventario.</p>
    </div>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div style="background-color: #E8F0EB; color: var(--color-accent); padding: 1rem; border-radius: var(--radius-base); margin-bottom: 1.5rem; border: 1px solid #A3C2B1;">
        @mensaje
    </div>
}

<div class="form-card" style="max-width: 800px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Nombre</p>
            <p style="font-weight: 600; font-size: 1.1rem;">@Model.Producto.Nombre</p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Descripción</p>
            <p>@(string.IsNullOrWhiteSpace(Model.Producto.DescripcionEspecifica) ? "Sin descripción" : Model.Producto.DescripcionEspecifica)</p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Categoría y Marca</p>
            <p>@Model.Producto.Categoria | @Model.Producto.Marca</p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Stock disponible</p>
            <p><span class="badge @(Model.Producto.Stock <= 5 ? "badge--accent" : "")" style="font-size: 1rem;">@Model.Producto.Stock unidades</span></p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Precio de venta</p>
            <p style="font-weight: 600; color: var(--color-primary); font-size: 1.1rem;">Bs. @Model.Producto.PrecioVenta.ToString("0.00")</p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">Costo de adquisición</p>
            <p>Bs. @Model.Producto.CostoAdquisicionActual.ToString("0.00")</p>
        </div>

        <div>
            <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">
                Perecedero
            </p>
            <p>@(Model.Producto.EsPerecedero ? "Sí" : "No")</p>
        </div>

        @if (Model.Producto.EsPerecedero)
        {
            <div>
                <p style="color: var(--color-secondary); font-size: 0.85rem; margin-bottom: 0.2rem;">
                    Fecha de vencimiento
                </p>
                <p>
                    @(Model.Producto.FechaVencimiento.HasValue
                        ? Model.Producto.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                        : "Sin fecha de vencimiento")
                </p>
            </div>
        }

    </div>

    @if (Model.Auditoria is not null)
    {
        <partial name="_AuditoriaInfo" model="Model.Auditoria" />
    }


    <div style="border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-top: 1.5rem;">
        <div style="display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem;">
            <div>
                <h2 style="margin: 0; font-size: 1.15rem;">
                    Histórico de costos
                </h2>
                <p style="color: var(--color-secondary); margin: 0.25rem 0 0;">
                    Variaciones registradas del costo de adquisición.
                </p>
            </div>

            <a asp-page="/Historico/Index"
               asp-route-publicId="@Model.PublicId"
               class="btn btn--secondary">
                Ver histórico completo
            </a>
        </div>

        @if (Model.Historico is null ||
             Model.Historico.Historial.Count == 0)
        {
            <div style="padding: 1.25rem; text-align: center; color: var(--color-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-base);">
                No existen registros históricos de costo.
            </div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Costo anterior</th>
                            <th>Costo nuevo</th>
                            <th>Variación</th>
                            <th>Vencimiento</th>
                            <th>Motivo</th>
                            <th>Registrado por</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Historico.Historial)
                        {
                            <tr>
                                <td>
                                    @item.FechaVigencia.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @if (item.CostoAnterior.HasValue)
                                    {
                                        <span>
                                            Bs. @item.CostoAnterior.Value.ToString("0.00")
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-secondary);">
                                            —
                                        </span>
                                    }
                                </td>

                                <td style="font-weight: 600;">
                                    Bs. @item.CostoNuevo.ToString("0.00")
                                </td>

                                <td>
                                    @if (item.VariacionAbsoluta.HasValue)
                                    {
                                        var variacion =
                                            item.VariacionAbsoluta.Value;

                                        if (variacion > 0)
                                        {
                                            <span style="color: #991B1B; font-weight: 600;">
                                                +@variacion.ToString("0.00")
                                            </span>
                                        }
                                        else if (variacion < 0)
                                        {
                                            <span style="color: var(--color-accent); font-weight: 600;">
                                                @variacion.ToString("0.00")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>0.00</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--color-secondary);">
                                            —
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.FechaVencimiento.HasValue
                                        ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                        : "—")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Motivo)
                                        ? "—"
                                        : item.Motivo)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.RegistradoPor)
                                        ? "—"
                                        : item.RegistradoPor)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div style="border-top: 1px solid var(--color-border); padding-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
        <a asp-page="Edit" asp-route-id="@Model.PublicId" class="btn btn--primary">Editar producto</a>

        <a asp-page="/Historico/Index" asp-route-publicId="@Model.PublicId" class="btn btn--secondary">Ver histórico</a>

        <a asp-page="Index" class="btn btn--secondary">Volver al catálogo</a>

        <button
            type="button"
            class="btn"
            style="background-color: #FEF2F2; color: #991B1B; border: 1px solid #FCA5A5; margin-left: auto;"
            data-confirm-trigger
            data-modal-target="producto-baja-modal"
            data-entity-id="@Model.PublicId"
            data-entity-name="@Model.Producto.Nombre">
            Dar de baja
        </button>
    </div>
</div>

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "producto-baja-modal",
        Titulo = "Confirmar baja de producto",
        MensajePrincipal = "¿Está seguro de dar de baja el producto",
        Handler = "DarDeBaja",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Confirmar baja",
        TextoBotonCancelar = "Cancelar",
        MensajeAdvertencia = "El producto no aparecerá en el catálogo activo pero su historial de costos y registros previos se conservarán."
    })
