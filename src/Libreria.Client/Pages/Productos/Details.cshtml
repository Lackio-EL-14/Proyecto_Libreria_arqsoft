@page "{id:guid}"
@model Libreria.Client.Pages.Productos.DetailsModel
@using Libreria.Client.Pages.Shared.Models

@{
    ViewData["Title"] = "Detalle del producto";
}

<div class="page-header">
    <div>
        <h1>@Model.Producto.Nombre</h1>
        <p>Detalle del artículo en el inventario.</p>
    </div>
    <div class="page-header__acciones">
        <a asp-page="Edit" asp-route-id="@Model.PublicId" class="btn btn--primary">Editar producto</a>
        <a asp-page="Index" class="btn btn--secondary">Volver a productos</a>
    </div>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="mensaje mensaje--exito" role="status">@mensaje</div>
}
@if (TempData["MensajeError"] is string error)
{
    <div class="mensaje mensaje--error" role="alert">@error</div>
}

<div class="form-card form-card--ancha">
    <dl class="ficha">
        <div>
            <dt>Stock disponible</dt>
            <dd>
                @if (Model.Producto.Stock <= 5)
                {
                    <span class="badge badge--warning">@Model.Producto.Stock unidades (stock bajo)</span>
                }
                else
                {
                    <span class="ficha__destacado">@Model.Producto.Stock unidades</span>
                }
            </dd>
        </div>

        <div>
            <dt>Precio de venta</dt>
            <dd class="ficha__precio">Bs. @Model.Producto.PrecioVenta.ToString("0.00")</dd>
        </div>

        <div>
            <dt>Costo de adquisición</dt>
            <dd>Bs. @Model.Producto.CostoAdquisicionActual.ToString("0.00")</dd>
        </div>

        <div>
            <dt>Categoría</dt>
            <dd>@Model.Producto.Categoria</dd>
        </div>

        <div>
            <dt>Marca</dt>
            <dd>@Model.Producto.Marca</dd>
        </div>

        <div>
            <dt>Vencimiento</dt>
            <dd>
                @if (!Model.Producto.EsPerecedero)
                {
                    <span>No es perecedero</span>
                }
                else if (Model.Producto.FechaVencimiento.HasValue)
                {
                    <span>Perecedero, vence el @Model.Producto.FechaVencimiento.Value.ToString("dd/MM/yyyy")</span>
                }
                else
                {
                    <span>Perecedero, sin fecha de vencimiento</span>
                }
            </dd>
        </div>

        <div class="ficha__completo">
            <dt>Descripción</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Producto.DescripcionEspecifica) ? "Sin descripción" : Model.Producto.DescripcionEspecifica)</dd>
        </div>
    </dl>

    @if (Model.Auditoria is not null)
    {
        <partial name="_AuditoriaInfo" model="Model.Auditoria" />
    }

    <section class="bloque" aria-labelledby="titulo-historico">
        <div class="bloque__cabecera">
            <div>
                <h2 id="titulo-historico">Histórico de costos</h2>
                <p>Variaciones registradas del costo de adquisición.</p>
            </div>
            <a asp-page="/Historico/Index"
               asp-route-publicId="@Model.PublicId"
               class="btn btn--secondary">
                Ver histórico completo
            </a>
        </div>

        @if (Model.Historico is null ||
             Model.Historico.Historial.Count == 0)
        {
            <div class="estado-vacio">
                <p>Todavía no hay cambios de costo registrados para este producto.</p>
            </div>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th class="num">Costo anterior</th>
                            <th class="num">Costo nuevo</th>
                            <th class="num">Variación</th>
                            <th>Vencimiento</th>
                            <th>Motivo</th>
                            <th>Registrado por</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Historico.Historial)
                        {
                            <tr>
                                <td>@FechaLocal.Mostrar(item.FechaVigencia)</td>
                                <td class="num">
                                    @if (item.CostoAnterior.HasValue)
                                    {
                                        <span>Bs. @item.CostoAnterior.Value.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="texto-secundario">—</span>
                                    }
                                </td>
                                <td class="num celda-principal">Bs. @item.CostoNuevo.ToString("0.00")</td>
                                <td class="num">
                                    @if (item.VariacionAbsoluta.HasValue)
                                    {
                                        var variacion = item.VariacionAbsoluta.Value;
                                        if (variacion > 0)
                                        {
                                            <span class="variacion variacion--sube">+@variacion.ToString("0.00")</span>
                                        }
                                        else if (variacion < 0)
                                        {
                                            <span class="variacion variacion--baja">@variacion.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            <span>0.00</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="texto-secundario">—</span>
                                    }
                                </td>
                                <td>
                                    @(item.FechaVencimiento.HasValue
                                        ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                        : "—")
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Motivo) ? "—" : item.Motivo)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.RegistradoPor) ? "—" : item.RegistradoPor)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="acciones-barra">
        <a asp-page="Edit" asp-route-id="@Model.PublicId" class="btn btn--primary">Editar producto</a>
        <a asp-page="Index" class="btn btn--secondary">Volver a productos</a>
        <button
            type="button"
            class="btn btn--peligro-suave acciones-barra__separado"
            data-confirm-trigger
            data-modal-target="producto-baja-modal"
            data-entity-id="@Model.PublicId"
            data-entity-name="@Model.Producto.Nombre">
            Dar de baja
        </button>
    </div>
</div>

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "producto-baja-modal",
        Titulo = "Confirmar baja de producto",
        MensajePrincipal = "¿Está seguro de dar de baja el producto",
        Handler = "DarDeBaja",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Confirmar baja",
        TextoBotonCancelar = "Cancelar",
        MensajeAdvertencia = "El producto no aparecerá en el catálogo activo, pero su historial de costos y registros previos se conservarán."
    })
