@page
@model Libreria.Client.Pages.Productos.IndexModel
@using Libreria.Client.Pages.Shared.Models

@{
    ViewData["Title"] = "Productos";
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Gestión del catálogo de productos e inventario.</p>
    </div>
    <a asp-page="Create" class="btn btn--primary">+ Registrar producto</a>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div style="background-color: #E8F0EB; color: var(--color-accent); padding: 1rem; border-radius: var(--radius-base); margin-bottom: 1.5rem; border: 1px solid #A3C2B1;">
        @mensaje
    </div>
}

<!-- Filtros en Grilla Horizontal -->
<form method="get" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; margin-bottom: 1.5rem; background-color: var(--color-surface); padding: 1.25rem; border-radius: var(--radius-base); border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);">
    <input type="hidden" name="Orden" value="@Model.Orden" />
    <input type="hidden" name="Direccion" value="@Model.Direccion" />

    
    <div class="form-group" style="margin-bottom: 0; flex: 2; min-width: 200px;">
        <label for="Busqueda">Buscar producto</label>
        <input type="text" id="Busqueda" name="Busqueda" class="form-control" value="@Model.Busqueda" placeholder="Nombre o descripción" />
    </div>

    <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
        <label for="CategoriaPublicId">Categoría</label>
        <select id="CategoriaPublicId" name="CategoriaPublicId" class="form-control">
            <option value="">Todas</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria.PublicId" selected="@(Model.CategoriaPublicId == categoria.PublicId)">
                    @categoria.Nombre
                </option>
            }
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 150px;">
        <label for="MarcaPublicId">Marca</label>
        <select id="MarcaPublicId" name="MarcaPublicId" class="form-control">
            <option value="">Todas</option>
            @foreach (var marca in Model.Marcas)
            {
                <option value="@marca.PublicId" selected="@(Model.MarcaPublicId == marca.PublicId)">
                    @marca.Nombre
                </option>
            }
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 140px;">
        <label for="Estado">Estado</label>
        <select id="Estado" name="Estado" class="form-control">
            <option value="" selected="@(!Model.Estado.HasValue)">Todos</option>
            <option value="true" selected="@(Model.Estado == true)">Activos</option>
            <option value="false" selected="@(Model.Estado == false)">Inactivos</option>
        </select>
    </div>

    <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn--secondary">Filtrar</button>

        <a asp-page="./Index"
           asp-route-Busqueda="@Model.Busqueda"
           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
           asp-route-MarcaPublicId="@Model.MarcaPublicId"
           asp-route-Estado="@Model.Estado"
           asp-route-Orden="@Model.Orden"
           asp-route-Direccion="@Model.Direccion"
           class="btn btn--secondary">
            Refrescar
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.CategoriaPublicId.HasValue || Model.MarcaPublicId.HasValue || Model.Estado.HasValue)
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Productos.Count == 0)
{
    <div style="text-align: center; color: var(--color-secondary); padding: 2rem; background-color: var(--color-surface); border-radius: var(--radius-base); border: 1px solid var(--color-border);">
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.CategoriaPublicId.HasValue || Model.MarcaPublicId.HasValue || Model.Estado.HasValue)
        {
            <p>No se encontraron productos que coincidan con los filtros seleccionados.</p>
        }
        else
        {
            <p>No hay productos registrados todavía.</p>
        }
    </div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="nombre"
                           asp-route-Direccion="@Model.SiguienteDireccion("nombre")"
                           style="color: inherit; text-decoration: none;">
                            Nombre <span>@(Model.IndicadorOrden("nombre"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="categoria"
                           asp-route-Direccion="@Model.SiguienteDireccion("categoria")"
                           style="color: inherit; text-decoration: none;">
                            Categoría <span>@(Model.IndicadorOrden("categoria"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="marca"
                           asp-route-Direccion="@Model.SiguienteDireccion("marca")"
                           style="color: inherit; text-decoration: none;">
                            Marca <span>@(Model.IndicadorOrden("marca"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="perecedero"
                           asp-route-Direccion="@Model.SiguienteDireccion("perecedero")"
                           style="color: inherit; text-decoration: none;">
                            Perecedero <span>@(Model.IndicadorOrden("perecedero"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="estado"
                           asp-route-Direccion="@Model.SiguienteDireccion("estado")"
                           style="color: inherit; text-decoration: none;">
                            Estado <span>@(Model.IndicadorOrden("estado"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="stock"
                           asp-route-Direccion="@Model.SiguienteDireccion("stock")"
                           style="color: inherit; text-decoration: none;">
                            Stock <span>@(Model.IndicadorOrden("stock"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="precio"
                           asp-route-Direccion="@Model.SiguienteDireccion("precio")"
                           style="color: inherit; text-decoration: none;">
                            Precio venta <span>@(Model.IndicadorOrden("precio"))</span>
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index"
                           asp-route-Busqueda="@Model.Busqueda"
                           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                           asp-route-MarcaPublicId="@Model.MarcaPublicId"
                           asp-route-Estado="@Model.Estado"
                           asp-route-Orden="costo"
                           asp-route-Direccion="@Model.SiguienteDireccion("costo")"
                           style="color: inherit; text-decoration: none;">
                            Costo adquisición <span>@(Model.IndicadorOrden("costo"))</span>
                        </a>
                    </th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    <tr>
                        <td style="font-weight: 600;">@producto.Nombre</td>
                        <td>@producto.Categoria</td>
                        <td>@producto.Marca</td>
                        <td>@(producto.EsPerecedero ? "Sí" : "No")</td>
                        <td>
                            <span class="badge">
                                @(producto.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(producto.Stock <= 5 ? "badge--accent" : "")">@producto.Stock</span>
                        </td>
                        <td>Bs. @producto.PrecioVenta.ToString("0.00")</td>
                        <td>Bs. @producto.CostoAdquisicionActual.ToString("0.00")</td>
                        <td>
                            <div class="table-actions">
                                @if (producto.Estado)
                                {
                                    <a asp-page="Details"
                                       asp-route-id="@producto.PublicId"
                                       class="btn-table">Ver</a>

                                    <a asp-page="/Historico/Index"
                                       asp-route-publicId="@producto.PublicId"
                                       class="btn-table">Histórico</a>

                                    <a asp-page="Edit"
                                       asp-route-id="@producto.PublicId"
                                       class="btn-table">Editar</a>

                                    <button
                                        type="button"
                                        class="btn-table btn-table--danger"
                                        data-confirm-trigger
                                        data-modal-target="producto-baja-modal"
                                        data-entity-id="@producto.PublicId"
                                        data-entity-name="@producto.Nombre">
                                        Dar de baja
                                    </button>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="Reactivar"
                                          style="display: inline;">
                                        <input type="hidden"
                                               name="publicId"
                                               value="@producto.PublicId" />
                                        <button type="submit"
                                                class="btn-table">
                                            Reactivar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "producto-baja-modal",
        Titulo = "Confirmar baja de producto",
        MensajePrincipal = "¿Está seguro de dar de baja el producto",
        Handler = "DarDeBaja",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Confirmar baja",
        TextoBotonCancelar = "Cancelar",
        MensajeAdvertencia = "El producto no aparecerá en el catálogo activo pero su historial de costos y registros previos se conservarán."
    })
