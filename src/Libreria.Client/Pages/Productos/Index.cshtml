@page
@model Libreria.Client.Pages.Productos.IndexModel
@using Libreria.Client.Pages.Shared.Models

@{
    ViewData["Title"] = "Productos";

    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Busqueda)
        || Model.CategoriaPublicId.HasValue
        || Model.MarcaPublicId.HasValue
        || Model.Estado.HasValue;

    // Columna (clave de orden del servicio), título y clase de la celda.
    var columnas = new (string Orden, string Titulo, string Clase)[]
    {
        ("nombre", "Nombre", ""),
        ("categoria", "Categoría", ""),
        ("marca", "Marca", ""),
        ("perecedero", "Perecedero", ""),
        ("estado", "Estado", ""),
        ("stock", "Stock", "num"),
        ("precio", "Precio de venta", "num"),
        ("costo", "Costo de adquisición", "num")
    };
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Catálogo de productos, stock y precios.</p>
    </div>
    <a asp-page="Create" class="btn btn--primary"><partial name="_Icono" model="@("mas")" /> Registrar producto</a>
</div>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="mensaje mensaje--exito" role="status">@mensaje</div>
}
@if (TempData["MensajeError"] is string error)
{
    <div class="mensaje mensaje--error" role="alert">@error</div>
}

<form method="get" class="filtro-barra">
    <input type="hidden" name="Orden" value="@Model.Orden" />
    <input type="hidden" name="Direccion" value="@Model.Direccion" />

    <div class="form-group filtro-barra__campo">
        <label for="Busqueda">Buscar por nombre o descripción</label>
        <input type="text" id="Busqueda" name="Busqueda" class="form-control" value="@Model.Busqueda" placeholder="Ej. Cuaderno" />
    </div>

    <div class="form-group filtro-barra__campo--select">
        <label for="CategoriaPublicId">Categoría</label>
        <select id="CategoriaPublicId" name="CategoriaPublicId" class="form-control">
            <option value="">Todas</option>
            @foreach (var categoria in Model.Categorias)
            {
                <option value="@categoria.PublicId" selected="@(Model.CategoriaPublicId == categoria.PublicId)">
                    @categoria.Nombre
                </option>
            }
        </select>
    </div>

    <div class="form-group filtro-barra__campo--select">
        <label for="MarcaPublicId">Marca</label>
        <select id="MarcaPublicId" name="MarcaPublicId" class="form-control">
            <option value="">Todas</option>
            @foreach (var marca in Model.Marcas)
            {
                <option value="@marca.PublicId" selected="@(Model.MarcaPublicId == marca.PublicId)">
                    @marca.Nombre
                </option>
            }
        </select>
    </div>

    <div class="form-group filtro-barra__estado">
        <label for="Estado">Estado</label>
        <select id="Estado" name="Estado" class="form-control">
            <option value="" selected="@(!Model.Estado.HasValue)">Todos</option>
            <option value="true" selected="@(Model.Estado == true)">Activos</option>
            <option value="false" selected="@(Model.Estado == false)">Inactivos</option>
        </select>
    </div>

    <div class="filtro-barra__acciones">
        <button type="submit" class="btn btn--secondary">Buscar</button>
        <a asp-page="./Index"
           asp-route-Busqueda="@Model.Busqueda"
           asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
           asp-route-MarcaPublicId="@Model.MarcaPublicId"
           asp-route-Estado="@Model.Estado"
           asp-route-Orden="@Model.Orden"
           asp-route-Direccion="@Model.Direccion"
           class="btn btn--secondary"
           title="Volver a consultar el listado con los mismos filtros">
            Actualizar
        </a>
        @if (hayFiltros)
        {
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        }
    </div>
</form>

@if (Model.Productos.Count == 0)
{
    <div class="estado-vacio">
        <partial name="_Icono" model="@("productos")" />
        @if (hayFiltros)
        {
            <p>No se encontraron productos con los filtros seleccionados. Revise la búsqueda o pulse «Limpiar».</p>
        }
        else
        {
            <p>No hay productos registrados todavía.</p>
            <a asp-page="Create" class="btn btn--primary"><partial name="_Icono" model="@("mas")" /> Registrar producto</a>
        }
    </div>
}
else
{
    <p class="tabla-resumen" role="status">Se muestran @Model.Productos.Count @(Model.Productos.Count == 1 ? "producto" : "productos"). Pulse el nombre para ver el detalle; el stock de 5 unidades o menos se marca como bajo.</p>
    <div class="table-container">
        <table class="tabla-compacta">
            <thead>
                <tr>
                    @foreach (var columna in columnas)
                    {
                        <th class="@columna.Clase">
                            <a asp-page="./Index"
                               asp-route-Busqueda="@Model.Busqueda"
                               asp-route-CategoriaPublicId="@Model.CategoriaPublicId"
                               asp-route-MarcaPublicId="@Model.MarcaPublicId"
                               asp-route-Estado="@Model.Estado"
                               asp-route-Orden="@columna.Orden"
                               asp-route-Direccion="@Model.SiguienteDireccion(columna.Orden)"
                               class="tabla-orden"
                               title="Ordenar por @columna.Titulo.ToLowerInvariant()">
                                @columna.Titulo <span aria-hidden="true">@Model.IndicadorOrden(columna.Orden)</span>
                            </a>
                        </th>
                    }
                    <th class="col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    <tr>
                        <td class="celda-principal">
                            @if (producto.Estado)
                            {
                                <a asp-page="Details" asp-route-id="@producto.PublicId" class="enlace-fila" title="Ver el detalle del producto">@producto.Nombre</a>
                            }
                            else
                            {
                                @producto.Nombre
                            }
                        </td>
                        <td>@producto.Categoria</td>
                        <td>@producto.Marca</td>
                        <td>@(producto.EsPerecedero ? "Sí" : "No")</td>
                        <td>
                            <span class="badge @(producto.Estado ? "badge--accent" : "")">
                                @(producto.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="num">
                            @if (producto.Stock <= 5)
                            {
                                <span class="badge badge--warning" title="Stock bajo">@producto.Stock</span>
                            }
                            else
                            {
                                @producto.Stock
                            }
                        </td>
                        <td class="num">Bs. @producto.PrecioVenta.ToString("0.00")</td>
                        <td class="num">Bs. @producto.CostoAdquisicionActual.ToString("0.00")</td>
                        <td>
                            <div class="table-actions">
                                @if (producto.Estado)
                                {
                                    <a asp-page="/Historico/Index"
                                       asp-route-publicId="@producto.PublicId"
                                       class="btn-table">Histórico</a>

                                    <a asp-page="Edit"
                                       asp-route-id="@producto.PublicId"
                                       class="btn-table">Editar</a>

                                    <button
                                        type="button"
                                        class="btn-table btn-table--danger"
                                        data-confirm-trigger
                                        data-modal-target="producto-baja-modal"
                                        data-entity-id="@producto.PublicId"
                                        data-entity-name="@producto.Nombre">
                                        Dar de baja
                                    </button>
                                }
                                else
                                {
                                    <button
                                        type="button"
                                        class="btn-table"
                                        data-confirm-trigger
                                        data-modal-target="producto-reactivar-modal"
                                        data-entity-id="@producto.PublicId"
                                        data-entity-name="@producto.Nombre">
                                        Reactivar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "producto-baja-modal",
        Titulo = "Confirmar baja de producto",
        MensajePrincipal = "¿Está seguro de dar de baja el producto",
        Handler = "DarDeBaja",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Confirmar baja",
        TextoBotonCancelar = "Cancelar",
        MensajeAdvertencia = "El producto no aparecerá en el catálogo activo, pero su historial de costos y registros previos se conservarán."
    })

@await Html.PartialAsync(
    "_ConfirmModal",
    new ConfirmModalModel
    {
        Id = "producto-reactivar-modal",
        Titulo = "Confirmar reactivación de producto",
        MensajePrincipal = "¿Desea reactivar el producto",
        Handler = "Reactivar",
        CampoIdentificador = "publicId",
        TextoBotonConfirmar = "Reactivar",
        TextoBotonCancelar = "Cancelar",
        ClaseBotonConfirmar = "btn--primary"
    })
