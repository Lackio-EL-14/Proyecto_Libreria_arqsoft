@page
@model Libreria.Client.Pages.Clientes.CreateModel

@{
    ViewData["Title"] = "Registrar cliente";
}

<div class="page-header">
    <div>
        <h1>Registrar cliente</h1>
        <p>Ingrese los datos del nuevo cliente.</p>
    </div>
</div>

<div class="form-card">
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

        <partial name="_ClienteFormularioCampos" for="Input" />

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Guardar</button>
            <a asp-page="./Index" class="btn btn--secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
