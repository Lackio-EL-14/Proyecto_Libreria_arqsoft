@model Libreria.Client.DTOs.Clientes.ClienteInput

@* Campos comunes del alta y la edición. Se usa con <partial for="Input">: los nombres "Input.*"
   coinciden con las claves de error que devuelve el MS Clientes (ResultadoApiTraductor).
   Etiquetas y mensajes salen de ClienteInput ([Display], [Required]…); jQuery unobtrusive
   los muestra antes de enviar y el MS vuelve a validar con su Result. *@
<p class="form-obligatorio">Los campos con <span class="text-danger">*</span> son obligatorios.</p>

<div class="form-group">
    <label asp-for="CiNit"></label>
    <input asp-for="CiNit" class="form-control" maxlength="30" placeholder="Ej. 4567890" />
    <span asp-validation-for="CiNit" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="RazonSocial"></label>
    <input asp-for="RazonSocial" class="form-control" maxlength="200" placeholder="Ej. María Fernanda Quispe Choque" />
    <span asp-validation-for="RazonSocial" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Correo"></label>
    <input asp-for="Correo" class="form-control" type="email" maxlength="254" placeholder="nombre@correo.bo" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>
