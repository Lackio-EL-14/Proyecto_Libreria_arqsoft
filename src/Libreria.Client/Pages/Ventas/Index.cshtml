@page
@model Libreria.Client.Pages.Ventas.IndexModel
@{
    ViewData["Title"] = "Listado de Ventas";
}

<div class="actions-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="margin: 0; font-size: 1.75rem; color: var(--color-primary); font-weight: 700;">Listado de Ventas</h1>
        <p style="margin: 0.25rem 0 0; color: var(--color-secondary); font-size: 0.9rem;">
            Historial de transacciones de venta y detalle de operaciones
        </p>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <span id="lblUltimoRefresco" style="font-size: 0.75rem; color: var(--color-secondary); font-family: monospace;"></span>
        <button type="button" id="btnRefrescarManual" class="btn btn--secondary" style="padding: 0.4rem 0.75rem; font-size: 0.85rem;" title="Refrescar lista ahora">
            🔄 Refrescar
        </button>
        <a asp-page="Registrar" class="btn btn--primary">
            + Nueva Venta
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert--success" style="margin-bottom: 1rem;">
        @Model.MensajeExito
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert--danger" style="margin-bottom: 1rem;">
        @Model.MensajeError
    </div>
}

<div class="card" style="margin-bottom: 1.5rem; padding: 1.25rem;">
    <form method="get" id="formFiltros" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 150px;">
            <label asp-for="Filtro.Estado" style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem;">Estado</label>
            <select asp-for="Filtro.Estado" class="form-control" style="width: 100%;">
                <option value="">Todos los estados</option>
                <option value="Activa">Activa</option>
                <option value="Anulada">Anulada</option>
            </select>
        </div>

        <div style="flex: 1; min-width: 160px;">
            <label asp-for="Filtro.FechaDesde" style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem;">Fecha Desde</label>
            <input asp-for="Filtro.FechaDesde" type="date" class="form-control" style="width: 100%;" />
        </div>

        <div style="flex: 1; min-width: 160px;">
            <label asp-for="Filtro.FechaHasta" style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem;">Fecha Hasta</label>
            <input asp-for="Filtro.FechaHasta" type="date" class="form-control" style="width: 100%;" />
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" id="btnFiltrar" class="btn btn--primary">Filtrar</button>
            <a asp-page="./Index" class="btn btn--secondary">Limpiar</a>
        </div>
    </form>
    <div id="errorRangoFechas" style="display: none; color: var(--color-danger); font-size: 0.82rem; margin-top: 0.5rem; align-items: center; gap: 0.35rem;">
        <span>⚠️ La 'Fecha desde' debe ser anterior o igual a la 'Fecha hasta'.</span>
    </div>
</div>

<div style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 0.75rem; gap: 0.4rem; font-size: 0.82rem; color: var(--color-secondary);">
    <label style="display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; user-select: none;">
        <input type="checkbox" id="chkAutoRefresco" checked style="cursor: pointer;" />
        Auto-refrescar cada 30 segundos
    </label>
</div>

@if (Model.Ventas.Count == 0)
{
    <div class="card" style="text-align: center; padding: 3rem 1rem; color: var(--color-secondary);">
        <p style="font-size: 1.1rem; margin: 0 0 1rem 0;">No se encontraron registros de ventas con los filtros aplicados.</p>
        <a asp-page="Registrar" class="btn btn--primary">Registrar Primera Venta</a>
    </div>
}
else
{
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Cliente</th>
                    <th>CI / NIT</th>
                    <th style="text-align: right;">Total</th>
                    <th style="text-align: center;">Estado</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venta in Model.Ventas)
                {
                    <tr>
                        <td style="white-space: nowrap;">
                            <strong style="color: var(--color-text);">@venta.FechaCreacion.ToString("dd/MM/yyyy")</strong>
                            <span style="font-size: 0.82rem; color: var(--color-secondary); display: block;">@venta.FechaCreacion.ToString("HH:mm")</span>
                        </td>
                        <td style="font-weight: 500;">@venta.ClienteNombre</td>
                        <td style="font-family: monospace;">@venta.ClienteCiNit</td>
                        <td style="text-align: right; font-weight: 700; white-space: nowrap; color: var(--color-primary);">
                            Bs. @venta.Total.ToString("N2")
                        </td>
                        <td style="text-align: center;">
                            @if (venta.Estado == "Activa")
                            {
                                <span class="badge badge--accent">Activa</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: var(--color-danger-bg); color: var(--color-danger); border: 1px solid var(--color-danger-border);">
                                    Anulada
                                </span>
                            }
                        </td>
                        <td style="text-align: center; white-space: nowrap;">
                            <button type="button"
                                    class="btn btn--secondary"
                                    style="padding: 0.35rem 0.65rem; font-size: 0.82rem;"
                                    onclick="abrirModalDetalle('@venta.PublicId')"
                                    title="Ver detalle completo">
                                👁️ Detalle
                            </button>

                            @if (Model.EsAdministrador && venta.Estado == "Activa")
                            {
                                <button type="button"
                                        class="btn btn--danger"
                                        style="padding: 0.35rem 0.65rem; font-size: 0.82rem; margin-left: 0.25rem;"
                                        onclick="abrirModalAnular('@venta.PublicId', '@venta.ClienteNombre', '@venta.Total.ToString("N2")')"
                                        title="Anular venta y restaurar stock">
                                    🚫 Anular
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<dialog id="modalDetalleVenta" class="confirmation-modal" aria-labelledby="modalDetalleTitulo" aria-modal="true" style="width: min(94vw, 760px); max-width: 760px; padding: 0;">
    <div class="confirmation-modal__content" style="max-width: 100%;">
        <header class="confirmation-modal__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.75rem;">
            <div>
                <h2 id="modalDetalleTitulo" style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin: 0 0 0.25rem 0;">Detalle de Venta</h2>
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                    <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-secondary); font-weight: 600;">Comprobante:</span>
                    <span id="detallePublicId" style="font-size: 0.78rem; color: var(--color-secondary); font-family: monospace;"></span>
                </div>
            </div>
            <button type="button" class="confirmation-modal__close" onclick="cerrarModalDetalle()" aria-label="Cerrar modal">&times;</button>
        </header>

        <div class="confirmation-modal__body" style="padding: 1.5rem 1.75rem; display: flex; flex-direction: column; gap: 1.25rem;">
            <div id="detalleLoader" style="text-align: center; padding: 2.5rem 1rem; color: var(--color-secondary);">
                <p style="margin: 0; font-size: 0.95rem;">Cargando información de la venta...</p>
            </div>

            <div id="detalleError" style="display: none; background-color: var(--color-danger-bg); color: var(--color-danger); padding: 1rem 1.25rem; border-radius: var(--radius-base); border: 1px solid var(--color-danger-border);">
                <span id="detalleErrorMensaje"></span>
            </div>

            <div id="detalleContenido" style="display: none;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem 1.25rem; background: var(--color-bg); padding: 1.25rem 1.5rem; border-radius: var(--radius-base); border: 1px solid var(--color-border); margin-bottom: 1.5rem; font-size: 0.88rem;">
                    <div>
                        <strong style="color: var(--color-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">Cliente</strong>
                        <span id="detalleClienteNombre" style="font-weight: 600; color: var(--color-text);"></span>
                    </div>
                    <div>
                        <strong style="color: var(--color-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">CI / NIT</strong>
                        <span id="detalleClienteCiNit" style="font-family: monospace; color: var(--color-text);"></span>
                    </div>
                    <div>
                        <strong style="color: var(--color-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">Fecha de Registro</strong>
                        <span id="detalleFechaCreacion" style="color: var(--color-text);"></span>
                    </div>
                    <div>
                        <strong style="color: var(--color-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">Estado</strong>
                        <span id="detalleEstadoBadge"></span>
                    </div>
                    <div>
                        <strong style="color: var(--color-secondary); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">Registrado por</strong>
                        <span id="detalleCreadoPor" style="color: var(--color-text);"></span>
                    </div>
                    <div id="detalleAnulacionContainer" style="display: none;">
                        <strong style="color: var(--color-danger); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">Anulado por</strong>
                        <span id="detalleAnuladoPor" style="color: var(--color-danger); font-weight: 500;"></span>
                        <span id="detalleFechaAnulacion" style="font-size: 0.78rem; color: var(--color-secondary); display: block;"></span>
                        <div style="margin-top: 0.5rem;">
                            <strong style="color: var(--color-danger); display: block; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.2rem;">
                                Motivo de anulación
                            </strong>
                            <span id="detalleMotivoAnulacion" style="color: var(--color-text);"></span>
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-primary); margin: 0 0 0.75rem 0;">Líneas de la Venta</h3>
                    <div class="table-container" style="margin-bottom: 0; max-height: 250px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: var(--radius-base);">
                        <table>
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th style="text-align: center;">Cantidad</th>
                                    <th style="text-align: right;">Precio Unit.</th>
                                    <th style="text-align: right;">Subtotal</th>
                                    @if (Model.EsAdministrador)
                                    {
                                        <th style="text-align: right; color: var(--color-accent);">Ganancia</th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="detalleLineasBody">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 1.25rem; align-items: stretch; padding-top: 1.25rem; border-top: 1px solid var(--color-border); flex-wrap: wrap;">
                    @if (Model.EsAdministrador)
                    {
                        <div id="detalleGananciaBox" style="min-width: 170px; text-align: right; background: #E8F0EB; padding: 0.75rem 1.25rem; border-radius: var(--radius-base); border: 1px solid #A3C2B1;">
                            <span style="font-size: 0.75rem; color: var(--color-accent); font-weight: 600; display: block; text-transform: uppercase; letter-spacing: 0.04em;">Ganancia Total</span>
                            <span id="detalleGananciaTotal" style="font-size: 1.2rem; font-weight: 700; color: var(--color-accent); display: block; margin-top: 0.2rem;"></span>
                        </div>
                    }

                    <div style="min-width: 180px; text-align: right; background: var(--color-bg); padding: 0.75rem 1.25rem; border-radius: var(--radius-base); border: 1px solid var(--color-border);">
                        <span style="font-size: 0.75rem; color: var(--color-secondary); font-weight: 600; display: block; text-transform: uppercase; letter-spacing: 0.04em;">Total Venta</span>
                        <span id="detalleTotalVenta" style="font-size: 1.35rem; font-weight: 800; color: var(--color-primary); display: block; margin-top: 0.2rem;"></span>
                    </div>
                </div>
            </div>
        </div>

        <footer class="confirmation-modal__actions" style="justify-content: flex-end; padding: 1.25rem 1.75rem;">
            <button type="button" class="btn btn--secondary" onclick="cerrarModalDetalle()">Cerrar</button>
        </footer>
    </div>
</dialog>

@if (Model.EsAdministrador)
{
    <dialog id="modalAnularVenta" class="confirmation-modal" aria-labelledby="modalAnularTitulo" aria-modal="true">
        <form method="post" asp-page-handler="Anular" class="confirmation-modal__content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="publicId" id="anularVentaPublicId" />

            <header class="confirmation-modal__header">
                <h2 id="modalAnularTitulo" style="color: var(--color-danger);">Confirmar Anulación de Venta</h2>
                <button type="button" class="confirmation-modal__close" onclick="cerrarModalAnular()" aria-label="Cerrar modal">&times;</button>
            </header>

            <div class="confirmation-modal__body">
                <p>
                    ¿Está seguro de que desea anular la venta del cliente
                    <strong id="anularClienteNombre"></strong>
                    por un monto de
                    <strong id="anularTotalVenta"></strong>?
                </p>

                <div class="form-group" style="margin-top: 1rem;">
                    <label for="motivoAnulacion">
                        Motivo de anulación
                    </label>

                    <textarea
                        id="motivoAnulacion"
                        name="motivoAnulacion"
                        class="form-control"
                        rows="4"
                        minlength="10"
                        maxlength="250"
                        required
                        placeholder="Ingrese el motivo de la anulación"></textarea>

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.35rem;">
                        <small style="color: var(--color-secondary);">
                            Debe ingresar entre 10 y 250 caracteres.
                        </small>
                        <span id="contadorCaracteresMotivo" style="font-size: 0.78rem; color: var(--color-secondary); font-family: monospace;">
                            0/250
                        </span>
                    </div>
                </div>

                <div class="confirmation-modal__warning"
                    style="margin-top: 1rem; background-color: var(--color-warning-bg); border: 1px solid var(--color-warning-border); padding: 0.75rem; border-radius: var(--radius-base); font-size: 0.85rem;">
                    <strong>⚠️ Importante:</strong>
                    Esta acción es irreversible. La anulación quedará registrada con
                    el usuario que la realiza, la fecha y el motivo indicado.
                    También se restaurará el stock de los productos de la venta.
                </div>
            </div>

            <footer class="confirmation-modal__actions">
                <button type="button" class="btn btn--secondary" onclick="cerrarModalAnular()">Cancelar</button>
                <button type="submit" class="btn btn--danger">Confirmar Anulación</button>
            </footer>
        </form>
    </dialog>
}

@section Scripts {
    <script>
        const esAdministrador = @(Model.EsAdministrador ? "true" : "false");
        const modalDetalle = document.getElementById('modalDetalleVenta');
        const modalAnular = document.getElementById('modalAnularVenta');
        let temporizadorRefresco = null;

        const formFiltros = document.getElementById('formFiltros');
        const inputFechaDesde = document.getElementById('Filtro_FechaDesde');
        const inputFechaHasta = document.getElementById('Filtro_FechaHasta');
        const errorRangoFechas = document.getElementById('errorRangoFechas');
        const btnFiltrar = document.getElementById('btnFiltrar');

        function sincronizarLimitesFechas() {
            if (!inputFechaDesde || !inputFechaHasta) return;

            if (inputFechaDesde.value) {
                inputFechaHasta.min = inputFechaDesde.value;
            } else {
                inputFechaHasta.removeAttribute('min');
            }

            if (inputFechaHasta.value) {
                inputFechaDesde.max = inputFechaHasta.value;
            } else {
                inputFechaDesde.removeAttribute('max');
            }
        }

        function validarFechasFiltro() {
            if (!inputFechaDesde || !inputFechaHasta) return true;

            sincronizarLimitesFechas();

            const desde = inputFechaDesde.value;
            const hasta = inputFechaHasta.value;

            if (desde && hasta && desde > hasta) {
                if (errorRangoFechas) errorRangoFechas.style.display = 'flex';
                inputFechaDesde.style.borderColor = 'var(--color-danger)';
                inputFechaHasta.style.borderColor = 'var(--color-danger)';
                if (btnFiltrar) {
                    btnFiltrar.disabled = true;
                    btnFiltrar.style.opacity = '0.6';
                    btnFiltrar.style.cursor = 'not-allowed';
                }
                return false;
            }

            if (errorRangoFechas) errorRangoFechas.style.display = 'none';
            inputFechaDesde.style.borderColor = '';
            inputFechaHasta.style.borderColor = '';
            if (btnFiltrar) {
                btnFiltrar.disabled = false;
                btnFiltrar.style.opacity = '1';
                btnFiltrar.style.cursor = '';
            }
            return true;
        }

        if (inputFechaDesde && inputFechaHasta) {
            inputFechaDesde.addEventListener('input', validarFechasFiltro);
            inputFechaDesde.addEventListener('change', validarFechasFiltro);
            inputFechaHasta.addEventListener('input', validarFechasFiltro);
            inputFechaHasta.addEventListener('change', validarFechasFiltro);
            validarFechasFiltro();
        }

        if (formFiltros) {
            formFiltros.addEventListener('submit', (e) => {
                if (!validarFechasFiltro()) {
                    e.preventDefault();
                    if (inputFechaDesde.value > inputFechaHasta.value) {
                        inputFechaDesde.focus();
                    }
                }
            });
        }

        function formatearMoneda(valor) {
            if (valor === null || valor === undefined) return 'Bs. 0.00';
            return 'Bs. ' + Number(valor).toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatearFecha(cadenaFecha) {
            if (!cadenaFecha) return '-';
            const fecha = new Date(cadenaFecha);
            if (isNaN(fecha.getTime())) return cadenaFecha;
            return fecha.toLocaleDateString('es-BO', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' +
                   fecha.toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit' });
        }

        async function abrirModalDetalle(publicId) {
            if (!modalDetalle) return;

            document.getElementById('detalleLoader').style.display = 'block';
            document.getElementById('detalleError').style.display = 'none';
            document.getElementById('detalleContenido').style.display = 'none';
            document.getElementById('detallePublicId').textContent = publicId;

            modalDetalle.showModal();

            try {
                const respuesta = await fetch(`?handler=Detalle&publicId=${encodeURIComponent(publicId)}`, {
                    headers: { 'Accept': 'application/json' }
                });

                if (!respuesta.ok) {
                    throw new Error('No se pudo cargar la información del detalle de la venta.');
                }

                const data = await respuesta.json();
                renderizarDetalle(data);
            } catch (error) {
                document.getElementById('detalleLoader').style.display = 'none';
                document.getElementById('detalleErrorMensaje').textContent = error.message;
                document.getElementById('detalleError').style.display = 'block';
            }
        }

        function renderizarDetalle(data) {
            document.getElementById('detalleClienteNombre').textContent = data.clienteNombre || '-';
            document.getElementById('detalleClienteCiNit').textContent = data.clienteCiNit || '-';
            document.getElementById('detalleFechaCreacion').textContent = formatearFecha(data.fechaCreacion);
            document.getElementById('detalleCreadoPor').textContent = data.creadoPor || '-';

            const badgeContainer = document.getElementById('detalleEstadoBadge');
            if (data.estado === 'Activa') {
                badgeContainer.innerHTML = '<span class="badge badge--accent">Activa</span>';
            } else {
                badgeContainer.innerHTML = '<span class="badge" style="background-color: var(--color-danger-bg); color: var(--color-danger); border: 1px solid var(--color-danger-border);">Anulada</span>';
            }

            const contAnulacion = document.getElementById('detalleAnulacionContainer');
            if (data.estado === 'Anulada') {
                contAnulacion.style.display = 'block';
                document.getElementById('detalleAnuladoPor').textContent = data.anuladoPor || 'Usuario';
                document.getElementById('detalleFechaAnulacion').textContent = formatearFecha(data.fechaAnulacion);
                document.getElementById('detalleMotivoAnulacion').textContent =
                    data.motivoAnulacion || 'Sin motivo registrado';
            } else {
                contAnulacion.style.display = 'none';
            }

            const tbody = document.getElementById('detalleLineasBody');
            tbody.innerHTML = '';

            if (data.lineas && data.lineas.length > 0) {
                data.lineas.forEach(linea => {
                    const tr = document.createElement('tr');
                    let html = `
                        <td style="font-weight: 500;">${linea.productoNombre}</td>
                        <td style="text-align: center;">${linea.cantidad}</td>
                        <td style="text-align: right; white-space: nowrap;">${formatearMoneda(linea.precioUnitario)}</td>
                        <td style="text-align: right; font-weight: 600; white-space: nowrap;">${formatearMoneda(linea.subtotal)}</td>
                    `;
                    if (esAdministrador) {
                        html += `<td style="text-align: right; color: var(--color-accent); font-weight: 600; white-space: nowrap;">${linea.ganancia !== null ? formatearMoneda(linea.ganancia) : '-'}</td>`;
                    }
                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                });
            }

            document.getElementById('detalleTotalVenta').textContent = formatearMoneda(data.total);

            if (esAdministrador && data.gananciaTotal !== null && data.gananciaTotal !== undefined) {
                const gananciaElem = document.getElementById('detalleGananciaTotal');
                if (gananciaElem) {
                    gananciaElem.textContent = formatearMoneda(data.gananciaTotal);
                }
            }

            document.getElementById('detalleLoader').style.display = 'none';
            document.getElementById('detalleContenido').style.display = 'block';
        }

        function cerrarModalDetalle() {
            if (modalDetalle) modalDetalle.close();
        }

        const textareaMotivo = document.getElementById('motivoAnulacion');
        const contadorMotivo = document.getElementById('contadorCaracteresMotivo');

        function actualizarContadorMotivo() {
            if (!textareaMotivo || !contadorMotivo) return;
            const longitud = textareaMotivo.value.length;
            contadorMotivo.textContent = `${longitud}/250`;
            if (longitud < 10) {
                contadorMotivo.style.color = 'var(--color-danger)';
            } else if (longitud > 240) {
                contadorMotivo.style.color = '#B45309'; // ámbar advertencia
            } else {
                contadorMotivo.style.color = 'var(--color-secondary)';
            }
        }

        if (textareaMotivo) {
            textareaMotivo.addEventListener('input', actualizarContadorMotivo);
        }

        function abrirModalAnular(publicId, clienteNombre, total) {
            if (!modalAnular) return;
            document.getElementById('anularVentaPublicId').value = publicId;
            document.getElementById('anularClienteNombre').textContent = clienteNombre;
            document.getElementById('anularTotalVenta').textContent = 'Bs. ' + total;
            document.getElementById('motivoAnulacion').value = '';
            actualizarContadorMotivo();
            modalAnular.showModal();
        }

        function cerrarModalAnular() {
            if (modalAnular) modalAnular.close();
        }

        [modalDetalle, modalAnular].forEach(dialog => {
            if (!dialog) return;
            dialog.addEventListener('click', (e) => {
                const rect = dialog.getBoundingClientRect();
                const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                                     rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
                if (!isInDialog) {
                    dialog.close();
                }
            });
        });

        function actualizarRelojRefresco() {
            const ahora = new Date();
            const texto = 'Último: ' + ahora.toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const lbl = document.getElementById('lblUltimoRefresco');
            if (lbl) lbl.textContent = texto;
        }

        function ejecutarRefresco() {
            if (document.hidden) return;
            if (modalDetalle && modalDetalle.open) return;
            if (modalAnular && modalAnular.open) return;

            window.location.reload();
        }

        function configurarAutoRefresco() {
            const chk = document.getElementById('chkAutoRefresco');
            if (!chk) return;

            if (temporizadorRefresco) {
                clearInterval(temporizadorRefresco);
                temporizadorRefresco = null;
            }

            if (chk.checked) {
                temporizadorRefresco = setInterval(ejecutarRefresco, 30000);
            }
        }

        const chkAuto = document.getElementById('chkAutoRefresco');
        if (chkAuto) {
            chkAuto.addEventListener('change', configurarAutoRefresco);
        }

        const btnManual = document.getElementById('btnRefrescarManual');
        if (btnManual) {
            btnManual.addEventListener('click', () => {
                window.location.reload();
            });
        }

        actualizarRelojRefresco();
        configurarAutoRefresco();
    </script>
}
