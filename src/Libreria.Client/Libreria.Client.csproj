
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Libreria.Client</RootNamespace>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libreria.Domain\Libreria.Domain.csproj" />
    <ProjectReference Include="..\Libreria.Application\Libreria.Application.csproj" />
    <ProjectReference Include="..\Libreria.Infrastructure\Libreria.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Pages\Categorias\**\*.cs" />
    <Compile Remove="Pages\Historico\**\*.cs" />
    <Compile Remove="Pages\Marcas\**\*.cs" />
    <Compile Remove="Pages\Productos\**\*.cs" />

    <Content Remove="Pages\Categorias\**\*.cshtml" />
    <Content Remove="Pages\Historico\**\*.cshtml" />
    <Content Remove="Pages\Marcas\**\*.cshtml" />
    <Content Remove="Pages\Productos\**\*.cshtml" />

    <None Include="Pages\Categorias\**\*" />
    <None Include="Pages\Historico\**\*" />
    <None Include="Pages\Marcas\**\*" />
    <None Include="Pages\Productos\**\*" />
  </ItemGroup>

</Project>
