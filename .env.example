# Configuración de Base de Datos
DB_CONNECTION_STRING=Server=db;Database=LibreriaDb;User Id=sa;Password=TuPassword123!;TrustServerCertificate=True;

# Configuración de Redis
Redis__Host=redis:6379
Redis__InstanceName=libreria:
Cache__ProductosActivos__ExpiracionMinutos=5

# Configuración de la Aplicación
BASE_URL=http://localhost:3000

# Configuración de Correo (SMTP)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_FROM=correo@ejemplo.com
