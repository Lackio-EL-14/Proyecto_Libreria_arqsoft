# Copiar a .env y completar. El .env real NUNCA se sube al repositorio.
# Docker Compose lee este archivo; las aplicaciones .NET no: a ellas se les pasan
# las variables ConnectionStrings__* y Keycloak__* por el entorno o user-secrets.

# --- Contenedores de BD (docker-compose.yml) ---
# SQL Server exige contraseñas fuertes: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
PROVEEDORES_DB_SA_PASSWORD=<contraseña>
USUARIOS_DB_SA_PASSWORD=<contraseña>
CLIENTES_DB_ROOT_PASSWORD=<contraseña>
CLIENTES_DB_USUARIO=libreria_clientes_app
CLIENTES_DB_PASSWORD=<contraseña>

# --- Cadenas de conexión de cada microservicio (sección 6.1) ---
ConnectionStrings__ProveedoresDb=Server=localhost,1433;Database=LibreriaProveedores;User Id=sa;Password=<contraseña>;TrustServerCertificate=True;
ConnectionStrings__UsuariosDb=Server=localhost,1434;Database=LibreriaUsuarios;User Id=sa;Password=<contraseña>;TrustServerCertificate=True;
ConnectionStrings__ClientesDb=Server=localhost;Port=3306;Database=libreria_clientes;User ID=libreria_clientes_app;Password=<contraseña>;
ConnectionStrings__ProductosDb=mongodb://localhost:27017/libreria_productos

# --- Keycloak (US-124, docs/contratos/keycloak.md) ---
# Administrador de arranque del contenedor (realm master). Solo para la consola en http://localhost:8080.
KC_BOOTSTRAP_ADMIN_USERNAME=<usuario-admin-keycloak>
KC_BOOTSTRAP_ADMIN_PASSWORD=<contraseña>
# Secretos de los clientes confidenciales: valores largos y aleatorios, por ejemplo
#   openssl rand -base64 32      ·      [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
KEYCLOAK_FRONT_CLIENT_SECRET=<secreto>
KEYCLOAK_USUARIOS_ADMIN_CLIENT_SECRET=<secreto>
KEYCLOAK_USUARIOS_VERIFICACION_CLIENT_SECRET=<secreto>
# Contraseñas de desarrollo de admin y vendedor en Keycloak. Deben cumplir la política del realm:
# 8+ caracteres, mayúscula, minúscula, número y carácter especial, y distinta del nombre de usuario.
KEYCLOAK_ADMIN_SEMILLA_PASSWORD=<contraseña>
KEYCLOAK_VENDEDOR_SEMILLA_PASSWORD=<contraseña>
# Cliente libreria-pruebas (direct grant, SOLO DESARROLLO): true para obtener tokens de prueba.
KEYCLOAK_HABILITAR_CLIENTE_PRUEBAS=true

# run-all.ps1 lee este mismo archivo y pasa a cada proceso .NET su secreto. Con dotnet run a mano:
#   Front:          Keycloak__ClientSecret = KEYCLOAK_FRONT_CLIENT_SECRET
#   MS Usuarios:    Keycloak__ClientSecret = KEYCLOAK_USUARIOS_ADMIN_CLIENT_SECRET
#                   Keycloak__VerificacionClientSecret = KEYCLOAK_USUARIOS_VERIFICACION_CLIENT_SECRET
# Keycloak__Authority y Keycloak__Audience ya están en appsettings.json.
# MS Usuarios sin Keycloak (solo Development): ProveedorIdentidad__Modo=EnMemoria

# --- Correo (MS Usuarios) ---
BASE_URL=http://localhost:5000
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_FROM=correo@ejemplo.com

# --- API Gateway (US-112): destinos de cada cluster; por defecto los de yarp.g1.json / yarp.g2.json ---
# Descomentar solo para apuntar un clúster a otra dirección durante una prueba local.
# ReverseProxy__Clusters__clientes__Destinations__principal__Address=http://localhost:5103
# ReverseProxy__Clusters__proveedores__Destinations__principal__Address=http://localhost:5101
# ReverseProxy__Clusters__productos__Destinations__principal__Address=http://localhost:5104
# ReverseProxy__Clusters__usuarios__Destinations__principal__Address=http://localhost:5102
